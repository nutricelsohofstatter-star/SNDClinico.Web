    .symbol-blue {
        background: #eaf3ff;
        color: #2377c4
    }

    .symbol-teal {
        background: #e8f7f4;
        color: #239889
    }

    .symbol-violet {
        background: #f1edff;
        color: #8068c5
    }

    .symbol-orange {
        background: #fff3e5;
        color: #d38b31
    }

    .clinical-card-copy {
        padding-top: 1px
    }

        .clinical-card-copy h2 {
            font-size: 14px;
            font-weight: 800;
            color: #173b5d;
            margin: 2px 0 7px
        }

        .clinical-card-copy p {
            font-size: 11px;
            line-height: 1.5;
            color: #8293a7;
            margin: 0
        }

    .clinical-card-action {
