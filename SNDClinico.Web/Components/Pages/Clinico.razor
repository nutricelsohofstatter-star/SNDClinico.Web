    private static string BuildSupplementSummary(params string[] values)
    {
        var names = new[] { "Cubitan", "Ensure", "Just", "Nutren 1.5", "Proline" };
        var items = values.Select((value, index) => (value, index))
            .Where(x => int.TryParse(x.value, out var amount) && amount > 0)
            .Select(x => $"{names[x.index]} {x.value}x/dia");
        var summary = string.Join(", ", items);
        return string.IsNullOrWhiteSpace(summary) ? "—" : summary;
    }

    private static string CalculateAdequacy(string prescribed, string recommended)
    {
        static decimal? ParseValue(string value)
        {
            var normalized = (value ?? "").Trim().Replace(",", ".");
            return decimal.TryParse(normalized, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var result) ? result : null;
        }
        var p = ParseValue(prescribed);
        var r = ParseValue(recommended);
        return p.HasValue && r.HasValue && r.Value > 0
            ? $"{Math.Round(p.Value / r.Value * 100m, 0)}%"
            : "—";
    }

