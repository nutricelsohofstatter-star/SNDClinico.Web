    .overview-footnote {
        display: flex;
        gap: 7px;
        align-items: center;
        margin-top: 14px;
        color: #98a5b4;
        font-size: 9px
    }

    .indicator-overview-empty {
        display: flex;
        align-items: center;
        gap: 15px;
        min-height: 96px
    }

    .overview-empty-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        background: #edf5ff;
        color: #4380b7;
        font-size: 24px
    }

    .reports-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 16px
    }

    .report-card {
        background: #fff;
        border: 1px solid #d9e5f0;
        border-radius: 13px;
        min-height: 172px;
        padding: 24px 22px 18px;
        display: grid;
        grid-template-columns: 68px 1fr;
        grid-template-rows: 1fr 42px;
        column-gap: 14px;
        box-shadow: 0 3px 12px #173b6808
    }

    .report-symbol {
        width: 54px;
        height: 54px;
        border-radius: 15px;
