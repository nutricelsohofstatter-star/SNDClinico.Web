    private void SelectSettingCategory(string key){SelectedSettingCategory=key;NewSettingName="";}
    private void AddClinicalSetting(){var name=NewSettingName.Trim();if(string.IsNullOrWhiteSpace(name)||string.IsNullOrWhiteSpace(SelectedSettingCategory))return;if(ClinicalSettings.Any(x=>x.Category==SelectedSettingCategory&&string.Equals(x.Name,name,StringComparison.OrdinalIgnoreCase))){ToastMessage="Este item já está cadastrado nesta categoria.";return;}ClinicalSettings.Add(new(){Id=NextClinicalSettingId++,Category=SelectedSettingCategory,Name=name});NewSettingName="";ToastMessage="Configuração adicionada nesta pré-visualização.";}
    private void ToggleClinicalSetting(int id){var item=ClinicalSettings.FirstOrDefault(x=>x.Id==id);if(item is null)return;item.Active=!item.Active;ToastMessage=item.Active?"Item ativado.":"Item inativado.";}
