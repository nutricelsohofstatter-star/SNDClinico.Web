@page "/clinico"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<PageTitle>SND Clínico</PageTitle>

<div class="clinico-app">
    <aside class="sidebar">
        <div class="brand"><div class="brand-mark">+</div><div><strong>SND <span>Clínico</span></strong><small>GESTÃO NUTRICIONAL HOSPITALAR</small></div></div>
        <div class="menu-caption">MENU PRINCIPAL</div>
        <nav>
            @foreach (var item in MenuItems)
            {
                <button class="nav-item @(ActiveSection == item.Key ? "active" : "")" @onclick="() => SelectSection(item.Key)">
                    <span class="nav-icon">@((MarkupString)item.Icon)</span><span>@item.Label</span>
                    @if (item.Key == "triagem")
                    {
                        <span class="nav-count">8</span>
                    }
                </button>
            }
        </nav>
        <div class="sidebar-profile"><div class="avatar">NC</div><div><b>Nutrição Clínica</b><small>Equipe assistencial</small></div><span class="dots">•••</span></div>
    </aside>

    <main class="main-area">
        <div class="content">
            @if (ActiveSection == "indicadores")
            {
                <div class="page-heading indicators-heading">
                    <div>
                        <h1>Indicadores</h1>
                        <p>Indicadores da assistência nutricional.</p>
                    </div>
                </div>

                <section class="clinical-cards" aria-label="Indicadores da assistência nutricional">
                    <article class="clinical-card @(SelectedIndicator == "triagem" ? "selected" : "")"
                             role="button" tabindex="0"
                             @onclick='() => SelectIndicator("triagem")'
                             @onkeydown='(e) => HandleIndicatorKey(e, "triagem")'>
                        <div class="clinical-card-top">
                            <div class="clinical-symbol"><img src="images/clinico/icone-triagem.png" alt="Ícone 3D de triagem nutricional" /></div>
                            <div class="clinical-card-copy">
                                <h2>Triagem nutricional</h2>
                                <p>Avaliação, classificação de risco e acompanhamento das triagens.</p>
                            </div>
                        </div>
                        <div class="clinical-card-action">
                            <span class="indicator-card-link">Ver indicadores gerais <span>→</span></span>
                        </div>
                    </article>

                    <article class="clinical-card @(SelectedIndicator == "mapa-adulto" ? "selected" : "")"
                             role="button" tabindex="0"
                             @onclick='() => SelectIndicator("mapa-adulto")'
                             @onkeydown='(e) => HandleIndicatorKey(e, "mapa-adulto")'>
                        <div class="clinical-card-top">
                            <div class="clinical-symbol"><img src="images/clinico/icone-mapa-adulto.png" alt="Ícone 3D de mapa de dietas adulto" /></div>
                            <div class="clinical-card-copy">
                                <h2>Mapa de dietas adulto</h2>
                                <p>Visualização geral das dietas e distribuição dos pacientes adultos.</p>
                            </div>
                        </div>
                        <div class="clinical-card-action">
                            <span class="indicator-card-link">Ver indicadores gerais <span>→</span></span>
                        </div>
                    </article>

                    <article class="clinical-card @(SelectedIndicator == "mapa-pediatrico" ? "selected" : "")"
                             role="button" tabindex="0"
                             @onclick='() => SelectIndicator("mapa-pediatrico")'
                             @onkeydown='(e) => HandleIndicatorKey(e, "mapa-pediatrico")'>
                        <div class="clinical-card-top">
                            <div class="clinical-symbol"><img src="images/clinico/icone-mapa-pediatria.png" alt="Ícone 3D de mapa de dietas pediatria" /></div>
                            <div class="clinical-card-copy">
                                <h2>Mapa de dietas pediatria</h2>
                                <p>Distribuição geral de dietas e acompanhamento dos pacientes pediátricos.</p>
                            </div>
                        </div>
                        <div class="clinical-card-action">
                            <span class="indicator-card-link">Ver indicadores gerais <span>→</span></span>
                        </div>
                    </article>

                    <article class="clinical-card @(SelectedIndicator == "aceitacao" ? "selected" : "")"
                             role="button" tabindex="0"
                             @onclick='() => SelectIndicator("aceitacao")'
                             @onkeydown='(e) => HandleIndicatorKey(e, "aceitacao")'>
                        <div class="clinical-card-top">
                            <div class="clinical-symbol"><img src="images/clinico/icone-aceitacao.png" alt="Ícone 3D de aceitação alimentar" /></div>
                            <div class="clinical-card-copy">
                                <h2>Aceitação alimentar</h2>
                                <p>Monitoramento geral da aceitação das refeições e do consumo alimentar.</p>
                            </div>
                        </div>
                        <div class="clinical-card-action">
                            <span class="indicator-card-link">Ver indicadores gerais <span>→</span></span>
                        </div>
                    </article>

                    <article class="clinical-card @(SelectedIndicator == "npo" ? "selected" : "")"
                             role="button" tabindex="0"
                             @onclick='() => SelectIndicator("npo")'
                             @onkeydown='(e) => HandleIndicatorKey(e, "npo")'>
                        <div class="clinical-card-top">
                            <div class="clinical-symbol"><img src="images/clinico/icone-npo.png" alt="Ícone 3D de NPO" /></div>
                            <div class="clinical-card-copy">
                                <h2>NPO</h2>
                                <p>Visão geral dos pacientes em NPO e do tempo de permanência em jejum.</p>
                            </div>
                        </div>
                        <div class="clinical-card-action">
                            <span class="indicator-card-link">Ver indicadores gerais <span>→</span></span>
                        </div>
                    </article>

                    <article class="clinical-card @(SelectedIndicator == "jejum" ? "selected" : "")"
                             role="button" tabindex="0"
                             @onclick='() => SelectIndicator("jejum")'
                             @onkeydown='(e) => HandleIndicatorKey(e, "jejum")'>
                        <div class="clinical-card-top">
                            <div class="clinical-symbol"><img src="images/clinico/icone-jejum.png" alt="Ícone 3D de abreviação de jejum" /></div>
                            <div class="clinical-card-copy">
                                <h2>Abreviação de jejum</h2>
                                <p>Acompanhamento geral do protocolo de abreviação do jejum pré-operatório.</p>
                            </div>
                        </div>
                        <div class="clinical-card-action">
                            <span class="indicator-card-link">Ver indicadores gerais <span>→</span></span>
                        </div>
                    </article>
                </section>

                @if (SelectedIndicator is not null)
                {
                    var selectedSummary = IndicatorSummaries.First(x => x.Key == SelectedIndicator);
                    <div class="indicator-modal-backdrop" @onclick="CloseIndicatorModal">
                        <section class="indicator-modal" role="dialog" aria-modal="true" aria-labelledby="indicator-modal-title" @onclick:stopPropagation="true">
                            <div class="indicator-modal-header">
                                <div>
                                    <span class="overview-eyebrow">VISÃO GERAL DO INDICADOR</span>
                                    <h2 id="indicator-modal-title">@selectedSummary.Title</h2>
                                    <p>@selectedSummary.Description</p>
                                </div>
                                <button type="button" class="modal-close" aria-label="Fechar" @onclick="CloseIndicatorModal">×</button>
                            </div>
                            <div class="modal-period-row">
                                <span class="overview-period">Dados demonstrativos</span>
                            </div>
                            <div class="overview-metrics">
                                @foreach (var metric in selectedSummary.Metrics)
                                {
                                    <div class="overview-metric">
                                        <span>@metric.Label</span>
                                        <strong>@metric.Value</strong>
                                        <small>@metric.Detail</small>
                                    </div>
                                }
                            </div>
                            <div class="overview-footnote">
                                <span>ⓘ</span>
                                Indicadores ilustrativos para definição do painel. Os valores serão conectados aos registros do sistema posteriormente.
                            </div>
                        </section>
                    </div>
                }

                <div class="demo-note">Esta é uma pré-visualização visual. Os indicadores exibidos são demonstrativos e não representam dados reais de pacientes.</div>
            }
            else if (ActiveSection == "triagem")
            {
                <div class="triage-page">
                    <div class="triage-heading">
                        <div>
                            <h1>Triagem nutricional</h1>
                            <p>Acompanhe as triagens, classificações e reavaliações nutricionais.</p>
                        </div>
                        <button class="triage-primary" @onclick="OpenNewTriage">＋ <span>Nova triagem</span></button>
                    </div>

                    <div class="triage-search-row">
                        <div class="triage-search">
                            <span>⌕</span>
                            <input value="@TriageSearch" @oninput="e => TriageSearch = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Buscar paciente" />
                        </div>
                        <span class="triage-total">@FilteredTriages.Count() triagens cadastradas</span>
                    </div>

                    <div class="triage-tabs" role="tablist" aria-label="Situação das triagens">
                        <button class="triage-tab @(TriageFilter == "aberto" ? "active" : "")" @onclick='() => SetTriageFilter("aberto")'>
                            <span class="tab-symbol">⚑</span> Em aberto <b>3</b>
                        </button>
                        <button class="triage-tab @(TriageFilter == "pendente" ? "active" : "")" @onclick='() => SetTriageFilter("pendente")'>
                            <span class="tab-symbol amber-text">⚠</span> Triagens pendentes <b class="count-amber">2</b>
                        </button>
                        <button class="triage-tab @(TriageFilter == "atrasado" ? "active" : "")" @onclick='() => SetTriageFilter("atrasado")'>
                            <span class="tab-symbol red-text">◷</span> Retornos atrasados <b class="count-red">1</b>
                        </button>
                        <button class="triage-tab @(TriageFilter == "proximo" ? "active" : "")" @onclick='() => SetTriageFilter("proximo")'>
                            <span class="tab-symbol">▦</span> Próximos retornos <b class="count-blue">0</b>
                        </button>
                        <button class="triage-tab @(TriageFilter == "todos" ? "active" : "")" @onclick='() => SetTriageFilter("todos")'>
                            <span class="tab-symbol">▱</span> Todos <b>10</b>
                        </button>
                    </div>

                    <section class="triage-table-panel">
                        <div class="triage-table-scroll">
                            <table class="triage-table">
                                <thead>
                                    <tr>
                                        <th>DATA DA<br />INTERNAÇÃO</th>
                                        <th>DATA DA<br />TRIAGEM</th>
                                        <th>LEITO</th>
                                        <th>NOME COMPLETO</th>
                                        <th>IDADE</th>
                                        <th>ESTADO<br />NUTRICIONAL</th>
                                        <th>MÉTODO DA<br />TRIAGEM</th>
                                        <th>RESULTADO</th>
                                        <th>NÍVEL DE<br />ASSISTÊNCIA</th>
                                        <th>MÉTODO DE<br />DIAGNÓSTICO</th>
                                        <th>DIAGNÓSTICO<br />NUTRICIONAL</th>
                                        <th>DATA DA<br />RETRIAGEM</th>
                                        <th>RESULTADO DA<br />RETRIAGEM</th>
                                        <th>PRÓXIMO<br />RETORNO</th>
                                        <th>AÇÕES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in FilteredTriages)
                                    {
                                        <tr>
                                            <td>@patient.AdmissionDate</td>
                                            <td>@patient.TriageDate</td>
                                            <td><b>@patient.Bed</b></td>
                                            <td class="patient-name">@patient.Name</td>
                                            <td>@patient.Age</td>
                                            <td><span class="triage-state @(patient.NutritionalState == "Risco nutricional" ? "risk" : "no-risk")">@patient.NutritionalState</span></td>
                                            <td>@patient.Method</td>
                                            <td>@patient.Result</td>
                                            <td>@patient.Assistance</td>
                                            <td>@patient.DiagnosisMethod</td>
                                            <td class="diagnosis-cell">@patient.Diagnosis</td>
                                            <td>@patient.RetriageDate</td>
                                            <td>@patient.RetriageResult</td>
                                            <td>@patient.NextReturn</td>
                                            <td class="triage-actions-cell">
                                                <div class="triage-action-wrap">
                                                    <button class="triage-actions-button" @onclick="() => ToggleTriageActions(patient.Id)">Ações⌄</button>
                                                    @if (OpenActionId == patient.Id)
                                                    {
                                                        <div class="triage-actions-menu">
                                                            <button @onclick="() => EditTriage(patient)">✎ &nbsp; Editar triagem</button>
                                                            <button @onclick="() => RegisterReturn(patient)">↻ &nbsp; Registrar retorno</button>
                                                            <button class="discharge" @onclick="() => DischargeTriage(patient)">Dar alta</button>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!FilteredTriages.Any())
                            {
                                <div class="triage-empty">Nenhuma triagem encontrada para esta busca ou aba.</div>
                            }
                        </div>
                    </section>
                    <div class="triage-footnote">Os registros exibidos nesta etapa são demonstrativos. A integração com o banco de dados será realizada posteriormente.</div>
                </div>
            }
            else if (ActiveSection == "mapa-adulto")
            {
                <div class="adult-map-page">
                    <div class="adult-map-heading">
                        <div>
                            <h1>Mapa de dietas adulto</h1>
                            <p>Acompanhe a terapia nutricional oral e enteral dos pacientes adultos.</p>
                        </div>
                    </div>

                    <div class="adult-map-toolbar">
                        <label class="adult-map-date">
                            <span>Data do mapa</span>
                            <input type="date" @bind="MapDate" />
                        </label>
                        <div class="adult-map-buttons">
                            <button class="adult-add-button" @onclick="OpenAdultPatientModal">＋ Adicionar paciente</button>
                            <button class="adult-copy-button" @onclick="CopyLastAdultMap">Copiar último mapa</button>
                        </div>
                    </div>

                    <div class="adult-map-search-row">
                        <div class="adult-map-search">
                            <span>⌕</span>
                            <input @bind="AdultMapSearch" @bind:event="oninput" placeholder="Buscar paciente, leito ou dieta..." />
                        </div>
                        <span class="adult-map-count">@FilteredAdultPatients.Count() pacientes no mapa</span>
                    </div>

                    <section class="adult-map-panel">
                        <div class="adult-map-table-wrap">
                            <table class="adult-map-table">
                                <thead>
                                    <tr>
                                        <th>Data do<br />mapa</th>
                                        <th>Leito</th>
                                        <th>Nome completo</th>
                                        <th>Idade</th>
                                        <th>Estado<br />nutricional</th>
                                        <th>Dieta</th>
                                        <th>Suplemento</th>
                                        <th>VM</th>
                                        <th>Diarreia</th>
                                        <th>Volume (mL)<br /><small>Infundido / Prescrito</small></th>
                                        <th>Calorias (kcal)<br /><small>Recomendada / Prescrita</small></th>
                                        <th>Adequação calórica<br /><small>Prescrita / Recomendada</small></th>
                                        <th>Proteína (g)<br /><small>Recomendada / Prescrita</small></th>
                                        <th>Adequação proteica<br /><small>Prescrita / Recomendada</small></th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in FilteredAdultPatients)
                                    {
                                        <tr>
                                            <td>@patient.MapDate</td>
                                            <td><b>@patient.Bed</b></td>
                                            <td class="adult-patient-name">@patient.Name</td>
                                            <td>@patient.Age</td>
                                            <td><span class="adult-state @(patient.NutritionalState == "Desnutrição" ? "adult-risk" : "adult-normal")">@patient.NutritionalState</span></td>
                                            <td>@patient.Diet</td>
                                            <td>@patient.SupplementSummary</td>
                                            <td>@(patient.MechanicalVentilation ? "Sim" : "Não")</td>
                                            <td>@(patient.Diarrhea ? "Sim" : "Não")</td>
                                            <td>@patient.VolumeInfused / @patient.VolumePrescribed</td>
                                            <td>@patient.CaloriesRecommended / @patient.CaloriesPrescribed</td>
                                            <td>@patient.CaloricAdequacy</td>
                                            <td>@patient.ProteinRecommended / @patient.ProteinPrescribed</td>
                                            <td>@patient.ProteinAdequacy</td>
                                            <td><button class="adult-row-action" @onclick="() => EditAdultPatient(patient)">Ações⌄</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!FilteredAdultPatients.Any())
                            {
                                <div class="adult-map-empty">Nenhum paciente encontrado para este mapa.</div>
                            }
                        </div>
                    </section>
                    <div class="adult-map-note">Os dados exibidos são demonstrativos. O preenchimento e os cálculos serão conectados aos registros clínicos e às composições nutricionais cadastradas posteriormente.</div>
                </div>
            }

            else if (ActiveSection == "mapa-pediatrico")
            {
                <div class="pediatric-map-page">
                    <div class="adult-map-heading">
                        <div>
                            <h1>Mapa de dietas pediátrico</h1>
                            <p>Acompanhe a terapia nutricional oral e enteral dos pacientes pediátricos.</p>
                        </div>
                    </div>

                    <div class="adult-map-toolbar">
                        <label class="adult-map-date">
                            <span>Data do mapa</span>
                            <input type="date" @bind="PediatricMapDate" />
                        </label>
                        <div class="adult-map-buttons">
                            <button class="adult-add-button" @onclick="OpenPediatricPatientModal">＋ Adicionar paciente</button>
                            <button class="adult-copy-button" @onclick="CopyLastPediatricMap">Copiar último mapa</button>
                        </div>
                    </div>

                    <div class="adult-map-search-row">
                        <div class="adult-map-search">
                            <span>⌕</span>
                            <input @bind="PediatricMapSearch" @bind:event="oninput" placeholder="Buscar paciente, leito ou dieta..." />
                        </div>
                        <span class="adult-map-count">@FilteredPediatricPatients.Count() pacientes no mapa</span>
                    </div>

                    <section class="adult-map-panel">
                        <div class="adult-map-table-wrap pediatric-map-table-wrap">
                            <table class="adult-map-table pediatric-map-table">
                                <thead>
                                    <tr>
                                        <th>Data do<br />mapa</th>
                                        <th>Leito</th>
                                        <th>Nome completo</th>
                                        <th>Idade</th>
                                        <th>Estado<br />nutricional</th>
                                        <th>Dieta</th>
                                        <th>VM</th>
                                        <th>Diarreia</th>
                                        <th>Volume (mL)<br /><small>Infundido / Prescrito</small></th>
                                        <th>Calorias (kcal)<br /><small>Recomendada / Prescrita</small></th>
                                        <th>Readequação calórica</th>
                                        <th>Proteína (g)<br /><small>Recomendada / Prescrita</small></th>
                                        <th>Readequação proteica</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in FilteredPediatricPatients)
                                    {
                                        <tr>
                                            <td>@patient.MapDate</td>
                                            <td><b>@patient.Bed</b></td>
                                            <td class="adult-patient-name">@patient.Name</td>
                                            <td>@patient.Age</td>
                                            <td><span class="adult-state @(patient.NutritionalState == "Desnutrição" ? "adult-risk" : "adult-normal")">@patient.NutritionalState</span></td>
                                            <td>@patient.Diet</td>
                                            <td>@(patient.MechanicalVentilation ? "Sim" : "Não")</td>
                                            <td>@(patient.Diarrhea ? "Sim" : "Não")</td>
                                            <td>@patient.VolumeInfused / @patient.VolumePrescribed</td>
                                            <td>@patient.CaloriesRecommended / @patient.CaloriesPrescribed</td>
                                            <td>@patient.CaloricAdequacy</td>
                                            <td>@patient.ProteinRecommended / @patient.ProteinPrescribed</td>
                                            <td>@patient.ProteinAdequacy</td>
                                            <td><button class="adult-row-action" @onclick="() => EditPediatricPatient(patient)">Ações⌄</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!FilteredPediatricPatients.Any())
                            {
                                <div class="adult-map-empty">Nenhum paciente pediátrico encontrado para este mapa.</div>
                            }
                        </div>
                    </section>
                    <div class="adult-map-note">Os dados exibidos são demonstrativos. O preenchimento e os cálculos serão conectados aos registros clínicos e às composições nutricionais cadastradas posteriormente.</div>
                </div>
            }

            else if (ActiveSection == "npo")
            {
                <div class="npo-page">
                    <div class="npo-heading">
                        <div>
                            <h1>NPO</h1>
                            <p>Monitore pacientes em jejum e o tempo de permanência em NPO.</p>
                        </div>
                        <button class="npo-primary" @onclick="OpenNewNpo">＋ <span>Novo registro</span></button>
                    </div>

                    <div class="npo-toolbar">
                        <div class="npo-tabs" role="tablist" aria-label="Situação dos registros NPO">
                            <button class="npo-tab @(NpoFilter == "todos" ? "active" : "")" @onclick='() => SetNpoFilter("todos")'>Todos <b>@NpoRecords.Count</b></button>
                            <button class="npo-tab @(NpoFilter == "andamento" ? "active" : "")" @onclick='() => SetNpoFilter("andamento")'>Em andamento <b>@NpoRecords.Count(x => !x.ExitDate.HasValue)</b></button>
                            <button class="npo-tab @(NpoFilter == "encerrados" ? "active" : "")" @onclick='() => SetNpoFilter("encerrados")'>Encerrados <b>@NpoRecords.Count(x => x.ExitDate.HasValue)</b></button>
                        </div>
                        <div class="npo-search"><span>⌕</span><input @bind="NpoSearch" @bind:event="oninput" placeholder="Pesquisar paciente, leito ou unidade" /></div>
                    </div>

                    <section class="npo-table-panel">
                        <div class="npo-table-scroll">
                            <table class="npo-table">
                                <thead>
                                    <tr>
                                        <th>Nome do paciente</th>
                                        <th>Idade</th>
                                        <th>Leito</th>
                                        <th>Unidade</th>
                                        <th>Data entrada NPO</th>
                                        <th>Hora entrada</th>
                                        <th>Data saída NPO</th>
                                        <th>Hora saída</th>
                                        <th>Total de horas</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in FilteredNpoRecords)
                                    {
                                        <tr>
                                            <td class="npo-patient-name">@record.PatientName</td>
                                            <td>@record.Age</td>
                                            <td><b>@record.Bed</b></td>
                                            <td>@record.Unit</td>
                                            <td>@(record.EntryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                            <td>@(string.IsNullOrWhiteSpace(record.EntryTime) ? "—" : record.EntryTime)</td>
                                            <td>@(record.ExitDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                            <td>@(string.IsNullOrWhiteSpace(record.ExitTime) ? "—" : record.ExitTime)</td>
                                            <td><span class="npo-duration @(record.ExitDate.HasValue ? "closed" : "ongoing")">@GetNpoDuration(record)</span></td>
                                            <td><button class="npo-action" @onclick="() => EditNpo(record)">@(record.ExitDate.HasValue ? "Visualizar / editar" : "Editar período")</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!FilteredNpoRecords.Any())
                            {
                                <div class="npo-empty">Nenhum registro NPO encontrado para esta busca ou filtro.</div>
                            }
                        </div>
                    </section>
                    <div class="npo-note">Os registros desta etapa são demonstrativos e permanecem apenas nesta pré-visualização. A integração com os dados de internação será realizada posteriormente.</div>
                </div>
            }
            else if (ActiveSection == "jejum")
            {
                <div class="fasting-page">
                    <div class="fasting-heading">
                        <div>
                            <h1>Abreviação de jejum</h1>
                            <p>Acompanhe a abreviação do jejum no pré-operatório.</p>
                        </div>
                        <button class="fasting-primary" @onclick="OpenNewFasting">＋ <span>Novo registro</span></button>
                    </div>
                    <div class="fasting-search-row">
                        <div class="fasting-search">
                            <span>⌕</span>
                            <input @bind="FastingSearch" @bind:event="oninput" placeholder="Buscar paciente, leito ou procedimento..." />
                        </div>
                        <span class="fasting-count">@FilteredFastingRecords.Count() registros</span>
                    </div>
                    <section class="fasting-table-panel">
                        <div class="fasting-table-wrap">
                            <table class="fasting-table">
                                <thead>
                                    <tr>
                                        <th>DATA</th>
                                        <th>HORÁRIO</th>
                                        <th>LEITO</th>
                                        <th>NOME COMPLETO</th>
                                        <th>IDADE</th>
                                        <th>PROCEDIMENTO CIRÚRGICO</th>
                                        <th>RECEBEU MALTO</th>
                                        <th>ÊMESE</th>
                                        <th>AÇÕES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in FilteredFastingRecords)
                                    {
                                        <tr>
                                            <td>@(record.Date?.ToString("dd/MM/yyyy") ?? "—")</td>
                                            <td>@(record.Time?.ToString("HH:mm") ?? "—")</td>
                                            <td><b>@record.Bed</b></td>
                                            <td class="fasting-patient-name">@record.PatientName</td>
                                            <td>@record.Age</td>
                                            <td>@record.Procedure</td>
                                            <td><span class="fasting-status @(record.ReceivedMalto == "Sim" ? "yes" : "neutral")">@record.ReceivedMalto</span></td>
                                            <td><span class="fasting-status @(record.Emesis == "Sim" ? "alert" : "neutral")">@record.Emesis</span></td>
                                            <td><button class="fasting-action" @onclick="() => EditFasting(record)">Ações⌄</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!FilteredFastingRecords.Any())
                            {
                                <div class="fasting-empty">Nenhum registro encontrado.</div>
                            }
                        </div>
                    </section>
                    <div class="fasting-note">Os registros exibidos são demonstrativos. A integração com a triagem e os dados de internação será realizada posteriormente.</div>
                </div>
            }
            else if (ActiveSection == "aceitacao")
            {
                <div class="acceptance-page">
                    <div class="acceptance-heading">
                        <div><h1>Aceitação alimentar</h1><p>Registre e acompanhe a aceitação das refeições.</p></div>
                        <button class="acceptance-primary" @onclick="OpenAcceptanceModal">＋ <span>Novo registro</span></button>
                    </div>
                    <div class="acceptance-toolbar">
                        <div class="acceptance-search"><span>⌕</span><input @bind="AcceptanceSearch" @bind:event="oninput" placeholder="Buscar paciente, leito ou informação..." /></div>
                        <select @bind="AcceptanceUnit"><option value="">Todas as unidades</option><option>UTI adulto</option><option>Clínica médica</option><option>Clínica cirúrgica</option></select>
                        <button class="acceptance-filter" @onclick="ClearAcceptanceFilters">⚑ &nbsp; Filtros</button>
                    </div>
                    <div class="acceptance-month">
                        <button aria-label="Mês anterior" @onclick="PreviousAcceptanceMonth">‹</button>
                        <strong>@AcceptanceMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("pt-BR"))</strong>
                        <button aria-label="Próximo mês" @onclick="NextAcceptanceMonth">›</button>
                    </div>
                    <section class="acceptance-panel">
                        <div class="acceptance-panel-heading"><div><h2>Aceitação alimentar</h2><p>Registros diários de aceitação das refeições e suplementação.</p></div><span class="acceptance-tag">PRÉ-VISUALIZAÇÃO</span></div>
                        <div class="acceptance-table-wrap">
                            <table class="acceptance-table">
                                <thead><tr><th>DATA</th><th>LEITO</th><th>NOME COMPLETO</th><th>IDADE</th><th>REFEIÇÕES REGISTRADAS</th><th>ACEITAÇÃO MÉDIA</th><th>SUPLEMENTOS</th><th>AÇÕES</th></tr></thead>
                                <tbody>
                                    @foreach (var record in FilteredAcceptanceRecords)
                                    {
                                        <tr><td>@record.Date.ToString("dd/MM/yyyy")</td><td><b>@record.Bed</b></td><td class="acceptance-patient">@record.PatientName</td><td>@record.Age</td><td>@record.MealsRegistered / 6</td><td><span class="acceptance-percent">@record.AverageAcceptance%</span></td><td>@(string.IsNullOrWhiteSpace(record.Supplement) ? "—" : record.Supplement)</td><td><button class="acceptance-action" @onclick="() => EditAcceptance(record)">Editar</button></td></tr>
                                    }
                                </tbody>
                            </table>
                            @if (!FilteredAcceptanceRecords.Any())
                            {
                                <div class="acceptance-empty">Nenhum registro encontrado neste período.</div>
                            }
                        </div>
                    </section>
                    <div class="acceptance-note">Esta versão é uma pré-visualização visual. Os registros são demonstrativos e não representam dados reais de pacientes.</div>
                </div>
            }
            else if (ActiveSection == "configuracoes")
            {
                <div class="clinical-settings-page">
                    <div class="settings-heading"><h1>Configurações</h1><p>Gerencie os cadastros e parâmetros utilizados nos módulos do SND Clínico.</p></div>
                    <section class="settings-card-grid">
                        @foreach (var category in ClinicalSettingCategories)
                        {
                            <button type="button" class="settings-category-card @(SelectedSettingCategory == category.Key ? "selected" : "")" @onclick="() => SelectSettingCategory(category.Key)">
                                <span class="settings-category-icon">@((MarkupString)category.Icon)</span><span class="settings-category-copy"><strong>@category.Title</strong><small>@category.Description</small><em>@ClinicalSettings.Count(x => x.Category == category.Key && x.Active) ativos</em></span><span class="settings-card-arrow">›</span>
                            </button>
                        }
                    </section>
                    @if (!string.IsNullOrWhiteSpace(SelectedSettingCategory))
                    {
                        var selectedCategory = ClinicalSettingCategories.First(x => x.Key == SelectedSettingCategory);
                        <section class="settings-detail-panel">
                            <header class="settings-detail-heading"><div><span class="settings-eyebrow">CADASTRO CLÍNICO</span><h2>@selectedCategory.Title</h2><p>@selectedCategory.Description</p></div><button type="button" class="settings-close" @onclick="() => SelectedSettingCategory = null">Fechar</button></header>
                            <div class="settings-add-row"><label>Novo item<input @bind="NewSettingName" @bind:event="oninput" placeholder="Digite o nome do cadastro" /></label><button type="button" class="settings-add-button" @onclick="AddClinicalSetting" disabled="@string.IsNullOrWhiteSpace(NewSettingName)">＋ Adicionar</button></div>
                            <div class="settings-list">
                                @foreach (var setting in ClinicalSettings.Where(x => x.Category == SelectedSettingCategory).OrderByDescending(x => x.Active).ThenBy(x => x.Name))
                                {
                                    <div class="settings-list-row"><span class="settings-item-status @(setting.Active ? "is-active" : "is-inactive")"></span><strong>@setting.Name</strong><span class="settings-item-state">@(setting.Active ? "Ativo" : "Inativo")</span><button type="button" class="settings-toggle-button" @onclick="() => ToggleClinicalSetting(setting.Id)">@(setting.Active ? "Inativar" : "Ativar")</button></div>
                                }
                                @if (!ClinicalSettings.Any(x => x.Category == SelectedSettingCategory)) { <div class="settings-empty">Nenhum item cadastrado. Adicione a primeira opção acima.</div> }
                            </div>
                            <p class="settings-footnote">Os cadastros ficam nesta pré-visualização. A persistência no banco e a utilização automática nos campos clínicos serão implementadas na próxima etapa.</p>
                        </section>
                    }
                </div>
            }

        </div>
    </main>
</div>
@if (ShowAdultPatientModal)
{
    <div class="adult-modal-backdrop" @onclick="CloseAdultPatientModal">
        <section class="adult-modal" role="dialog" aria-modal="true" aria-labelledby="adult-modal-title" @onclick:stopPropagation="true">
            <header class="adult-modal-header">
                <div class="adult-modal-brand">✚</div>
                <div class="adult-modal-title">
                    <small>SND CLÍNICO · NUTRIÇÃO HOSPITALAR</small>
                    <h2 id="adult-modal-title">Registro nutricional — Adulto</h2>
                    <p>@MapDateDisplay · Terapia nutricional oral e enteral</p>
                </div>
                <button class="adult-modal-close" @onclick="CloseAdultPatientModal">×</button>
            </header>
            <div class="adult-modal-body">
                <section class="adult-patient-summary">
                    <div><small>PACIENTE</small><b>@(string.IsNullOrWhiteSpace(AdultFormName) ? "Novo paciente" : AdultFormName)</b></div>
                    <div><small>LEITO / IDADE</small><b>@(string.IsNullOrWhiteSpace(AdultFormBed) ? "—" : AdultFormBed) · @(string.IsNullOrWhiteSpace(AdultFormAge) ? "—" : AdultFormAge)</b></div>
                    <div><small>ESTADO NUTRICIONAL</small><b class="adult-summary-state">@AdultFormNutritionalState</b></div>
                </section>

                <div class="adult-copy-hint">
                    <div><b>Facilitar preenchimento</b><small>Recupere os valores da última avaliação deste paciente nesta pré-visualização.</small></div>
                    <button @onclick="CopyPreviousAdultPatient">Copiar dados anteriores deste paciente</button>
                </div>

                <section class="adult-form-section">
                    <div class="adult-section-title"><span>01</span><div><b>Identificação e terapia nutricional</b><small>Dados do paciente e acompanhamento clínico</small></div></div>
                    <div class="adult-form-grid">
                        <label>Nome completo<input @bind="AdultFormName" placeholder="Nome completo do paciente" /></label>
                        <label>Leito<input @bind="AdultFormBed" placeholder="Ex.: 102C" /></label>
                        <label>Idade<input @bind="AdultFormAge" placeholder="Ex.: 74 anos" /></label>
                        <label>Estado nutricional<select @bind="AdultFormNutritionalState"><option>Não avaliado</option><option>Eutrofia</option><option>Risco nutricional</option><option>Desnutrição</option><option>Obesidade</option></select></label>
                        <label class="adult-field-wide">Dieta<select @bind="AdultFormDiet"><option>Não definida</option><option>Oral</option><option>Enteral</option><option>Oral + enteral</option><option>Jejum</option></select></label>
                        <label>Suplemento — Cubitan (porções/dia)<input type="number" min="0" step="1" @bind="AdultFormCubitan" /></label>
                        <label>Ensure (porções/dia)<input type="number" min="0" step="1" @bind="AdultFormEnsure" /></label>
                        <label>Just (porções/dia)<input type="number" min="0" step="1" @bind="AdultFormJust" /></label>
                        <label>Nutren 1.5 (porções/dia)<input type="number" min="0" step="1" @bind="AdultFormNutren" /></label>
                        <label>Proline (porções/dia)<input type="number" min="0" step="1" @bind="AdultFormProline" /></label>
                        <label class="adult-field-wide">Resumo dos suplementos<input value="@AdultSupplementSummary" readonly /></label>
                        <label class="adult-check"><input type="checkbox" @bind="AdultFormMechanicalVentilation" /> Ventilação mecânica</label>
                        <label class="adult-check"><input type="checkbox" @bind="AdultFormDiarrhea" /> Diarreia</label>
                        <label>Volume prescrito (mL)<input type="number" min="0" step="1" @bind="AdultFormVolumePrescribed" /></label>
                        <label>Volume infundido (mL)<input type="number" min="0" step="1" @bind="AdultFormVolumeInfused" /></label>
                    </div>
                </section>

                <section class="adult-form-section">
                    <div class="adult-section-title"><span>02</span><div><b>Energia e proteínas</b><small>O cálculo automático utilizará somente composições verificadas no catálogo institucional</small></div></div>
                    <div class="adult-form-grid">
                        <label>Calorias recomendadas (kcal)<input @bind="AdultFormCaloriesRecommended" placeholder="Valor recomendado" /></label>
                        <label>Calorias prescritas (kcal)<input @bind="AdultFormCaloriesPrescribed" placeholder="Valor prescrito" /></label>
                        <label>Proteína recomendada (g)<input @bind="AdultFormProteinRecommended" placeholder="Valor recomendado" /></label>
                        <label>Proteína prescrita (g)<input @bind="AdultFormProteinPrescribed" placeholder="Valor prescrito" /></label>
                    </div>
                </section>

                <section class="adult-form-section">
                    <div class="adult-section-title"><span>03</span><div><b>Adequação da prescrição nutricional</b><small>Prescrito em relação ao recomendado · indicadores visuais demonstrativos</small></div></div>
                    <div class="adult-adequacy-grid">
                        <div><small>ADEQUAÇÃO CALÓRICA (PRESCRITA / RECOMENDADA)</small><strong>@AdultCaloricAdequacy</strong></div>
                        <div><small>ADEQUAÇÃO PROTEICA (PRESCRITA / RECOMENDADA)</small><strong>@AdultProteinAdequacy</strong></div>
                    </div>
                    <p class="adult-calc-note">Os percentuais serão calculados quando os valores recomendados e prescritos estiverem preenchidos corretamente.</p>
                </section>
            </div>
            <footer class="adult-modal-footer">
                <span>@(EditingAdultPatientId == 0 ? "Novo registro" : "Editando paciente")</span>
                <div><button class="adult-cancel" @onclick="CloseAdultPatientModal">Cancelar</button><button class="adult-save" @onclick="SaveAdultPatient">Salvar e fechar</button><button class="adult-save-next" @onclick="SaveAdultPatientAndNext">Salvar e próximo</button></div>
            </footer>
        </section>
    </div>
}


