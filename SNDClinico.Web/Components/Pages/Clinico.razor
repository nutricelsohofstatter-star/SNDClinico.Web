@page "/clinico"
@using Microsoft.AspNetCore.Components

<PageTitle>SND Hospitalar | @TituloPagina</PageTitle>

<style>
    .clin-app{min-height:100vh;display:flex;background:#f1f6fc;color:#263e5b;font-family:Inter,"Segoe UI",sans-serif}
    .clin-sidebar{width:252px;min-width:252px;height:100vh;position:sticky;top:0;display:flex;flex-direction:column;padding:22px 16px 15px;background:#fff;border-right:1px solid #dce6f0;z-index:5}
    .clin-brand{display:flex;align-items:center;gap:11px;padding:2px 8px 22px;text-decoration:none;border-bottom:1px solid #e7edf4}
    .clin-brand-symbol{width:40px;height:40px;display:grid;place-items:center;flex-shrink:0;border-radius:12px;background:linear-gradient(145deg,#1597ed,#0865c9);color:#fff;box-shadow:0 5px 12px #0869c733}
    .clin-brand-symbol svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .clin-brand-text strong{display:block;color:#102f54;font-size:15px;font-weight:850;letter-spacing:-.4px}
    .clin-brand-text small{display:block;margin-top:4px;color:#71859d;font-size:8px;font-weight:650;letter-spacing:.7px;line-height:1.5}
    .clin-menu-label{margin:27px 10px 11px;color:#7589a1;font-size:9px;font-weight:850;letter-spacing:1.3px}
    .clin-navigation{display:flex;flex-direction:column;gap:5px;overflow-y:auto}
    .clin-nav-item{position:relative;display:flex;align-items:center;gap:12px;width:100%;min-height:43px;padding:10px 12px;border:0;border-radius:9px;background:transparent;color:#526b86;text-align:left;font-family:inherit;font-size:11px;font-weight:600;cursor:pointer;transition:background .2s,color .2s,transform .2s}
    .clin-nav-item:hover{background:#f0f6fc;color:#075fae;transform:translateX(2px)}
    .clin-nav-item.active{background:#e5f1fd;color:#075eaa;font-weight:800}
    .clin-nav-item.active:before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:3px;border-radius:4px;background:#087bd1}
    .clin-nav-icon{width:20px;height:20px;display:grid;place-items:center;flex-shrink:0}
    .clin-nav-icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .clin-sidebar-bottom{margin-top:auto;padding-top:12px}
    .clin-sidebar-divider{height:1px;margin-bottom:12px;background:#e7edf4}
    .clin-back-link{display:flex;align-items:center;gap:10px;padding:11px 10px;color:#526b86;font-size:11px;font-weight:600;text-decoration:none;border-radius:8px}
    .clin-back-link:hover{color:#075fae;background:#f1f6fb}
    .clin-sidebar-footer{display:flex;align-items:center;gap:8px;padding:17px 10px 2px;color:#72869c;font-size:8px;font-weight:800;letter-spacing:1px}
    .clin-footer-dot{width:7px;height:7px;border-radius:50%;background:#17b58b;box-shadow:0 0 0 3px #e5f7f1}
    .clin-main{min-width:0;flex:1;display:flex;flex-direction:column}
    .clin-content{width:100%;max-width:1700px;padding:36px 32px 35px;margin:0 auto;flex:1}
    .clin-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:25px}
    .clin-eyebrow{display:block;margin-bottom:7px;color:#0874c6;font-size:9px;font-weight:850;letter-spacing:1.4px}
    .clin-heading h1{margin:0;color:#17395f;font-size:27px;font-weight:850;letter-spacing:-.9px}
    .clin-heading p{margin:8px 0 0;color:#526d89;font-size:12px;line-height:1.6}
    .clin-status{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border:1px solid #d8e9e5;border-radius:9px;background:#f1faf7;color:#287a66;font-size:10px;font-weight:750;white-space:nowrap}
    .clin-status span{width:7px;height:7px;border-radius:50%;background:#20ad83}
    .clin-welcome{display:flex;align-items:flex-start;gap:15px;padding:20px 22px;border:1px solid #dce8f2;border-radius:13px;background:linear-gradient(120deg,#fff,#f7fbff);box-shadow:0 3px 14px #193b5b08}
    .clin-welcome-icon{width:42px;height:42px;display:grid;place-items:center;flex-shrink:0;border-radius:12px;background:#e6f2fd;color:#0875c7}
    .clin-welcome-icon svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .clin-welcome strong{display:block;color:#234565;font-size:13px;font-weight:800}
    .clin-welcome p{margin:5px 0 0;color:#71869b;font-size:11px;line-height:1.6}
    .clin-section-title{margin:27px 0 12px;color:#607991;font-size:9px;font-weight:850;letter-spacing:1.2px}
    .clin-module-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
    .clin-module-card{display:flex;align-items:flex-start;gap:13px;min-height:105px;padding:17px;border:1px solid #dce6f0;border-radius:12px;background:#fff;text-align:left;cursor:pointer;transition:transform .18s,border-color .18s,box-shadow .18s}
    .clin-module-card:hover{transform:translateY(-2px);border-color:#a9cbe6;box-shadow:0 8px 20px #193b5b0d}
    .clin-module-icon{width:38px;height:38px;display:grid;place-items:center;flex-shrink:0;border-radius:10px;background:#edf5fd;color:#0874c6}
    .clin-module-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .clin-module-card strong{display:block;margin:1px 0 5px;color:#234565;font-size:12px;font-weight:800}
    .clin-module-card small{display:block;color:#71869b;font-size:10px;line-height:1.55}
    .clin-placeholder{margin-top:18px;padding:24px;border:1px dashed #cbdbe9;border-radius:13px;background:#fff;text-align:center}
    .clin-placeholder-icon{width:46px;height:46px;margin:0 auto 12px;display:grid;place-items:center;border-radius:13px;background:#edf5fd;color:#0874c6}
    .clin-placeholder-icon svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .clin-placeholder strong{display:block;color:#294866;font-size:13px}
    .clin-placeholder p{max-width:560px;margin:7px auto 0;color:#71869b;font-size:11px;line-height:1.7}
    .clin-footer{margin-top:30px;padding-top:15px;border-top:1px solid #e0e9f1;display:flex;justify-content:space-between;gap:12px;color:#7c8fa3;font-size:9px}
    @@media(max-width:1050px){.clin-sidebar{width:226px;min-width:226px}.clin-module-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.clin-content{padding:28px 22px}}
    @@media(max-width:720px){.clin-app{display:block}.clin-sidebar{width:100%;min-width:0;height:auto;position:relative;padding:12px}.clin-brand{padding-bottom:12px}.clin-menu-label{margin:14px 8px 8px}.clin-navigation{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.clin-nav-item{min-height:40px;padding:8px;font-size:10px}.clin-sidebar-bottom{margin-top:12px}.clin-sidebar-footer{display:none}.clin-content{padding:23px 14px}.clin-heading{align-items:flex-start;flex-direction:column}.clin-module-grid{grid-template-columns:1fr}.clin-footer{flex-direction:column}}
</style>

<div class="clin-app">
    <aside class="clin-sidebar">
        <a href="/" class="clin-brand">
            <div class="clin-brand-symbol" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18"/></svg>
            </div>
            <div class="clin-brand-text">
                <strong>SND Hospitalar</strong>
                <small>GESTÃO DE NUTRIÇÃO HOSPITALAR</small>
            </div>
        </a>

        <div class="clin-menu-label">MENU CLÍNICO</div>
        <nav class="clin-navigation" aria-label="Navegação do SND Clínico">
            @foreach (var item in ItensMenu)
            {
                <button type="button" class="@ClasseMenu(item.Id)" @onclick="() => AbrirSecao(item.Id)" title="@item.Titulo">
                    <span class="clin-nav-icon">@((MarkupString)item.Icone)</span>
                    <span>@item.Titulo</span>
                </button>
            }
        </nav>

        <div class="clin-sidebar-bottom">
            <div class="clin-sidebar-divider"></div>
            <a href="/" class="clin-back-link"><span>←</span><span>Voltar ao painel inicial</span></a>
            <div class="clin-sidebar-footer"><span class="clin-footer-dot"></span>SND HOSPITALAR</div>
        </div>
    </aside>

    <main class="clin-main">
        <div class="clin-content">
            <header class="clin-heading">
                <div>
                    <span class="clin-eyebrow">ASSISTÊNCIA E TERAPIA NUTRICIONAL</span>
                    <h1>@TituloPagina</h1>
                    <p>@DescricaoPagina</p>
                </div>
                <div class="clin-status"><span></span>Área clínica</div>
            </header>

            @if (SecaoSelecionada == "inicio")
            {
                <section class="clin-welcome">
                    <div class="clin-welcome-icon">
                        <svg viewBox="0 0 24 24"><path d="M3 18V7a2 2 0 0 1 2-2h5a3 3 0 0 1 3 3v10M3 14h18M13 10h6a2 2 0 0 1 2 2v6M7 9h2"/></svg>
                    </div>
                    <div>
                        <strong>Bem-vindo ao SND Clínico</strong>
                        <p>Centralize a assistência nutricional, acompanhe os pacientes internados e organize os registros clínicos em um único ambiente.</p>
                    </div>
                </section>

                <div class="clin-section-title">MÓDULOS ASSISTENCIAIS</div>
                <section class="clin-module-grid">
                    @foreach (var item in ItensMenu.Where(x => x.Id != "inicio" && x.Id != "configuracoes"))
                    {
                        <button type="button" class="clin-module-card" @onclick="() => AbrirSecao(item.Id)">
                            <span class="clin-module-icon">@((MarkupString)item.Icone)</span>
                            <span><strong>@item.Titulo</strong><small>@item.Descricao</small></span>
                        </button>
                    }
                </section>
            }
            else
            {
                <section class="clin-placeholder">
                    <div class="clin-placeholder-icon">
                        <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h5"/></svg>
                    </div>
                    <strong>@TituloPagina</strong>
                    <p>A aba está criada na estrutura do SND Clínico. Nesta primeira etapa estamos organizando a navegação e a identidade visual. As funcionalidades e integrações serão implementadas por módulo, após definirmos suas regras.</p>
                </section>
            }

            <footer class="clin-footer">
                <span><strong>SND CLÍNICO</strong> · Assistência nutricional hospitalar</span>
                <span>Hospital São Sebastião Mártir</span>
            </footer>
        </div>
    </main>
</div>

@code {
    private string SecaoSelecionada = "inicio";

    private sealed record ItemClinico(string Id, string Titulo, string Descricao, string Icone);

    private readonly List<ItemClinico> ItensMenu = new()
    {
        new("inicio", "Visão geral", "Resumo e acesso aos módulos clínicos.", "<svg viewBox='0 0 24 24'><rect x='3' y='3' width='7' height='7' rx='1'/><rect x='14' y='3' width='7' height='7' rx='1'/><rect x='3' y='14' width='7' height='7' rx='1'/><rect x='14' y='14' width='7' height='7' rx='1'/></svg>"),
        new("triagem", "Triagem nutricional", "Avaliação de risco, classificação e reavaliação.", "<svg viewBox='0 0 24 24'><path d='M9 3h6M10 3v3h4V3M6 6h12v15H6zM9 11h6M9 15h6'/></svg>"),
        new("adulto", "Mapa de dietas adulto", "Acompanhamento das dietas e necessidades nutricionais.", "<svg viewBox='0 0 24 24'><circle cx='9' cy='7' r='3'/><path d='M3 21v-2a6 6 0 0 1 12 0v2M17 8h4M19 6v4'/></svg>"),
        new("pediatrico", "Mapa de dietas pediátrico", "Acompanhamento nutricional de pacientes pediátricos.", "<svg viewBox='0 0 24 24'><circle cx='12' cy='7' r='3'/><path d='M5 21v-2a7 7 0 0 1 14 0v2M9 7h.01M15 7h.01'/></svg>"),
        new("ficha", "Ficha do paciente", "Dados clínicos e histórico nutricional centralizados.", "<svg viewBox='0 0 24 24'><path d='M7 3h8l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM15 3v5h4M9 13h6M9 17h6'/></svg>"),
        new("evolucoes", "Evoluções nutricionais", "Registros de acompanhamento e condutas nutricionais.", "<svg viewBox='0 0 24 24'><path d='M4 19h16M6 16l3-4 3 2 5-7M16 7h3v3'/></svg>"),
        new("aceitacao", "Aceitação alimentar", "Monitoramento diário do consumo das refeições.", "<svg viewBox='0 0 24 24'><path d='M3 11h18M5 11a7 7 0 0 0 14 0M12 4v3M7 3l2 3M17 3l-2 3'/></svg>"),
        new("npo", "NPO", "Controle de início, término e duração do jejum.", "<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>"),
        new("jejum", "Abreviação de jejum", "Acompanhamento de preparo e abreviação do jejum.", "<svg viewBox='0 0 24 24'><rect x='3' y='4' width='18' height='17' rx='2'/><path d='M16 2v4M8 2v4M3 10h18M8 14h3'/></svg>"),
        new("protocolos", "Protocolos nutricionais", "Protocolos, critérios e condutas institucionais.", "<svg viewBox='0 0 24 24'><path d='M5 3h14v18H5zM8 8h8M8 12h8M8 16h5'/></svg>"),
        new("indicadores", "Indicadores e relatórios", "Indicadores assistenciais e relatórios clínicos.", "<svg viewBox='0 0 24 24'><path d='M4 19V5M4 19h17M7 15l4-4 3 2 6-7'/></svg>"),
        new("configuracoes", "Configurações", "Parâmetros e listas utilizadas nos módulos clínicos.", "<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='3'/><path d='m19 13 2 1-2 3-2-1-2 1v2h-4v-2l-2-1-2 1-2-3 2-1v-2l-2-1 2-3 2 1 2-1V5h4v2l2 1 2-1 2 3-2 1z'/></svg>")
    };

    private string TituloPagina => ItensMenu.First(x => x.Id == SecaoSelecionada).Titulo;
    private string DescricaoPagina => SecaoSelecionada switch
    {
        "inicio" => "Ambiente de trabalho da equipe de nutrição clínica.",
        "configuracoes" => "Gerencie os parâmetros e as opções do ambiente clínico.",
        _ => ItensMenu.First(x => x.Id == SecaoSelecionada).Descricao
    };

    private string ClasseMenu(string id) => SecaoSelecionada == id ? "clin-nav-item active" : "clin-nav-item";
    private void AbrirSecao(string id) => SecaoSelecionada = id;
}