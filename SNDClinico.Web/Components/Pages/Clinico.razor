            width: 8%;
        }

        .triage-table th:nth-child(5), .triage-table td:nth-child(5) {
            width: 4.2%;
        }

        .triage-table th:nth-child(6), .triage-table td:nth-child(6) {
            width: 7%;
        }

        .triage-table th:nth-child(7), .triage-table td:nth-child(7) {
            width: 6.5%;
        }

        .triage-table th:nth-child(8), .triage-table td:nth-child(8) {
            width: 5%;
        }

        .triage-table th:nth-child(9), .triage-table td:nth-child(9) {
            width: 6.2%;
        }

        .triage-table th:nth-child(10), .triage-table td:nth-child(10) {
            width: 6.5%;
        }

        .triage-table th:nth-child(11), .triage-table td:nth-child(11) {
            width: 8%;
        }

        .triage-table th:nth-child(12), .triage-table td:nth-child(12) {
            width: 6.2%;
        }

        .triage-table th:nth-child(13), .triage-table td:nth-child(13) {
            width: 7%;
        }

        .triage-table th:nth-child(14), .triage-table td:nth-child(14) {
            width: 6.2%;
        }

        .triage-table th:nth-child(15), .triage-table td:nth-child(15) {
