        place-items: center;
        font-size: 29px;
        font-weight: 700;
        grid-row: 1;
        box-shadow: 0 5px 12px #173b6812
    }

    .report-blue {
        background: #eaf3ff;
        color: #2377c4
    }

    .report-teal {
        background: #e8f7f4;
        color: #239889
    }

    .report-violet {
        background: #f1edff;
        color: #8068c5
    }

    .report-orange {
        background: #fff3e5;
        color: #d38b31
    }

    .report-card-copy {
        align-self: start;
        padding-top: 2px
    }

        .report-card-copy h2 {
            font-size: 14px;
            font-weight: 700;
            color: #173b5d;
            margin: 2px 0 7px
        }

        .report-card-copy p {
            font-size: 11px;
            line-height: 1.55;
            color: #8293a7;
            margin: 0
        }

    .report-action {
        grid-column: 1/3;
        justify-self: center;
        align-self: end;
        width: min(250px,85%);
        height: 40px;
        border: 0;
        border-radius: 9px;
        background: linear-gradient(100deg,#168bd0,#0870b5);
        color: white;
        font: 700 11px Inter,sans-serif;
        cursor: pointer;
        box-shadow: 0 4px 9px #0870b52b;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px
    }

        .report-action:hover {
            filter: brightness(.96);
            transform: translateY(-1px)
        }

        .report-action span {
            font-size: 16px;
            font-weight: 400
        }



    .indicator-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(18, 38, 61, .48);
        backdrop-filter: blur(3px);
        animation: indicatorFadeIn .16s ease-out;
    }

    .indicator-modal {
        width: min(760px, 100%);
        max-height: min(85vh, 720px);
        overflow-y: auto;
        background: #fff;
        border: 1px solid #dce7f3;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 22px 70px rgba(16, 42, 70, .24);
        animation: indicatorModalIn .2s ease-out;
    }

    .indicator-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
    }

        .indicator-modal-header h2 {
            margin: 7px 0 6px;
            color: #203852;
            font-size: 21px;
            letter-spacing: -.4px;
        }

        .indicator-modal-header p {
            margin: 0;
            color: #8996a6;
            font-size: 12px;
            line-height: 1.6;
        }

    .modal-close {
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        border: 1px solid #e4ebf3;
        border-radius: 9px;
        background: #f8fafc;
        color: #65778c;
        font-size: 23px;
        line-height: 1;
        cursor: pointer;
    }

        .modal-close:hover {
            background: #edf5ff;
            border-color: #b8d5f2;
            color: #2868ad;
        }

    .modal-period-row {
        display: flex;
        justify-content: flex-end;
        margin: 17px 0 12px;
    }

    .indicator-modal .overview-metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .indicator-modal .overview-metric {
        min-width: 0;
        padding: 16px;
        border: 1px solid #dfe9f4;
        border-radius: 10px;
        background: #fbfdff;
    }

        .indicator-modal .overview-metric strong {
            display: block;
            margin: 8px 0 5px;
            color: #173b68;
            font-size: 25px;
            font-weight: 700;
        }

        .indicator-modal .overview-metric span,
        .indicator-modal .overview-metric small {
            display: block;
            color: #8293a7;
            font-size: 10px;
            line-height: 1.5;
        }

    .indicator-modal .overview-footnote {
        display: flex;
        gap: 8px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #edf1f6;
        color: #8998a9;
        font-size: 10px;
        line-height: 1.5;
    }

    @@keyframes indicatorFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes indicatorModalIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.985);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@media(max-width:600px) {
        .indicator-modal {
            padding: 19px;
        }

            .indicator-modal .overview-metrics {
                grid-template-columns: 1fr;
            }

        .indicator-modal-backdrop {
            padding: 12px;
        }
    }

    @@media(max-width:1000px) {
        .clinical-cards {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .reports-grid {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }
    }

    @@media(max-width:650px) {
        .clinical-cards {
            grid-template-columns: 1fr
        }

        .clinical-card {            min-height: 130px;
