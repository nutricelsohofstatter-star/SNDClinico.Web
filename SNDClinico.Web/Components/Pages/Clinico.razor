        border: 1px solid #d7e4f0;
        border-radius: 13px;
        box-shadow: 0 3px 12px #173b6808
    }

    .indicator-overview-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px
    }

    .overview-eyebrow {
