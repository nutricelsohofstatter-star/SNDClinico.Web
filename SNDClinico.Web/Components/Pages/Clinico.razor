    // Controle de NPO — registros demonstrativos, sem persistência em banco nesta etapa.
    private sealed class NpoRecord
    {
        public int Id { get; set; }
        public string PatientName { get; set; } = "";
        public string Age { get; set; } = "";
        public string Bed { get; set; } = "";
        public string Unit { get; set; } = "";
        public DateTime? EntryDate { get; set; }
        public string EntryTime { get; set; } = "";
        public DateTime? ExitDate { get; set; }
        public string ExitTime { get; set; } = "";
    }
    private List<NpoRecord> NpoRecords = new()
    {
        new() { Id = 1, PatientName = "Roberto Almeida", Age = "67 anos", Bed = "108-2", Unit = "UTI adulto", EntryDate = DateTime.Today, EntryTime = "06:00" },
        new() { Id = 2, PatientName = "Carolina Mendes", Age = "42 anos", Bed = "315-1", Unit = "Clínica cirúrgica", EntryDate = DateTime.Today.AddDays(-1), EntryTime = "22:00", ExitDate = DateTime.Today, ExitTime = "10:00" }
    };

    private string NpoFilter { get; set; } = "todos";
    private string NpoSearch { get; set; } = "";
    private bool ShowNpoModal { get; set; }
    private int EditingNpoId { get; set; }
    private string NpoFormPatientName { get; set; } = "";
    private string NpoFormAge { get; set; } = "";
    private string NpoFormBed { get; set; } = "";
    private string NpoFormUnit { get; set; } = "";
    private DateTime? NpoFormEntryDate { get; set; } = DateTime.Today;
    private TimeOnly? NpoFormEntryTime { get; set; } = new TimeOnly(0, 0);
    private DateTime? NpoFormExitDate { get; set; }
    private TimeOnly? NpoFormExitTime { get; set; }

    private IEnumerable<NpoRecord> FilteredNpoRecords => NpoRecords.Where(x =>
        (NpoFilter == "todos" || (NpoFilter == "andamento" && !x.ExitDate.HasValue) || (NpoFilter == "encerrados" && x.ExitDate.HasValue)) &&
        (string.IsNullOrWhiteSpace(NpoSearch) || $"{x.PatientName} {x.Age} {x.Bed} {x.Unit}".Contains(NpoSearch, StringComparison.OrdinalIgnoreCase)));

    private string NpoFormDuration => GetNpoDuration(new NpoRecord
    {
        EntryDate = NpoFormEntryDate,
        EntryTime = NpoFormEntryTime?.ToString("HH:mm") ?? "",
        ExitDate = NpoFormExitDate,
        ExitTime = NpoFormExitTime?.ToString("HH:mm") ?? ""
    });

    private static DateTime? BuildNpoDateTime(DateTime? date, string time)
    {
        if (!date.HasValue || !TimeSpan.TryParse(time, out var parsedTime)) return null;
        return date.Value.Date.Add(parsedTime);
    }

    private static string GetNpoDuration(NpoRecord record)
    {
        var start = BuildNpoDateTime(record.EntryDate, record.EntryTime);
        if (!start.HasValue) return "—";
        var end = BuildNpoDateTime(record.ExitDate, record.ExitTime);
        if (!end.HasValue) end = DateTime.Now;
        if (end.Value < start.Value) return "Verificar horários";
        var duration = end.Value - start.Value;
        var totalHours = (int)Math.Floor(duration.TotalHours);
        return $"{totalHours}h {duration.Minutes:D2}min";
    }

    private void SetNpoFilter(string filter) => NpoFilter = filter;

    private void ResetNpoForm()
    {
        EditingNpoId = 0;
        NpoFormPatientName = NpoFormAge = NpoFormBed = NpoFormUnit = "";
        NpoFormEntryDate = DateTime.Today;
        NpoFormEntryTime = TimeOnly.FromDateTime(DateTime.Now);
        NpoFormExitDate = null;
        NpoFormExitTime = null;
    }

    private void OpenNewNpo()
    {
        ResetNpoForm();
        ShowNpoModal = true;
    }

    private void EditNpo(NpoRecord record)
    {
        EditingNpoId = record.Id;
        NpoFormPatientName = record.PatientName;
        NpoFormAge = record.Age;
        NpoFormBed = record.Bed;
        NpoFormUnit = record.Unit;
        NpoFormEntryDate = record.EntryDate;
        NpoFormEntryTime = TimeOnly.TryParse(record.EntryTime, out var entryTime) ? entryTime : null;
        NpoFormExitDate = record.ExitDate;
        NpoFormExitTime = TimeOnly.TryParse(record.ExitTime, out var exitTime) ? exitTime : null;
        ShowNpoModal = true;
    }

    private void CloseNpoModal() => ShowNpoModal = false;

    private void SaveNpo()
    {
        if (string.IsNullOrWhiteSpace(NpoFormPatientName) || string.IsNullOrWhiteSpace(NpoFormBed) ||
            string.IsNullOrWhiteSpace(NpoFormUnit) || !NpoFormEntryDate.HasValue || !NpoFormEntryTime.HasValue)
        {
            ToastMessage = "Preencha paciente, leito, unidade, data e hora de entrada.";
            return;
        }

        if (NpoFormExitDate.HasValue && !NpoFormExitTime.HasValue)
        {
            ToastMessage = "Informe a hora de saída para calcular o período de NPO.";
            return;
        }

        var updated = new NpoRecord
        {
            Id = EditingNpoId == 0 ? (NpoRecords.Count == 0 ? 1 : NpoRecords.Max(x => x.Id) + 1) : EditingNpoId,
            PatientName = NpoFormPatientName.Trim(),
            Age = NpoFormAge.Trim(),
            Bed = NpoFormBed.Trim(),
            Unit = NpoFormUnit.Trim(),
            EntryDate = NpoFormEntryDate,
            EntryTime = NpoFormEntryTime?.ToString("HH:mm") ?? "",
            ExitDate = NpoFormExitDate,
            ExitTime = NpoFormExitTime?.ToString("HH:mm") ?? ""
        };

        if (updated.ExitDate.HasValue && BuildNpoDateTime(updated.ExitDate, updated.ExitTime) < BuildNpoDateTime(updated.EntryDate, updated.EntryTime))
        {
            ToastMessage = "A saída do NPO não pode ser anterior à entrada.";
            return;
        }

        if (EditingNpoId == 0)
            NpoRecords.Add(updated);
        else
        {
            var index = NpoRecords.FindIndex(x => x.Id == EditingNpoId);
            if (index >= 0) NpoRecords[index] = updated;
        }

        ShowNpoModal = false;
        ToastMessage = "Registro NPO atualizado nesta pré-visualização.";
    }

