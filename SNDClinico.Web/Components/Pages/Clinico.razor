    private RenderFragment DemoTable(string[] Headers, string[][] Rows) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "table-wrap");
        builder.OpenElement(seq++, "table"); builder.OpenElement(seq++, "thead"); builder.OpenElement(seq++, "tr");
        foreach (var header in Headers) { builder.OpenElement(seq++, "th"); builder.AddContent(seq++, header); builder.CloseElement(); }
        builder.CloseElement(); builder.CloseElement(); builder.OpenElement(seq++, "tbody");
        foreach (var row in Rows) { builder.OpenElement(seq++, "tr"); foreach (var cell in row) { builder.OpenElement(seq++, "td"); builder.AddContent(seq++, cell); builder.CloseElement(); } builder.CloseElement(); }
        builder.CloseElement(); builder.CloseElement(); builder.CloseElement();
    };

