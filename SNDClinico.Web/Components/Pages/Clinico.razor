@if (ShowAcceptanceModal)
{
    <div class="acceptance-backdrop" @onclick="CloseAcceptanceModal">
        <section class="acceptance-modal" role="dialog" aria-modal="true" aria-labelledby="acceptance-modal-title" @onclick:stopPropagation="true">
            <header class="acceptance-modal-header">
                <div><small>SND CLÍNICO · REGISTRO DIÁRIO</small><h2 id="acceptance-modal-title">@(EditingAcceptanceId == 0 ? "Nova aceitação alimentar" : "Editar aceitação alimentar")</h2><p>Ficha por paciente, com refeições e suplementação em separado</p></div>
                <button @onclick="CloseAcceptanceModal" aria-label="Fechar">×</button>
            </header>
            <div class="acceptance-modal-body">
                <section class="acceptance-form-section">
                    <h3>01 · Identificação</h3>
                    <label class="acceptance-full">
                        Paciente da Triagem
                        <select @bind="AcceptanceFormTriageId" @bind:after="LoadAcceptancePatient">
                            <option value="0">Selecione o paciente internado</option>@foreach (var patient in TriageRows) {
                            <option value="@patient.Id">@patient.Name</option>
                        }
                    </select>
                </label>
                <div class="acceptance-patient-summary"><div><small>PACIENTE</small><b>@(string.IsNullOrWhiteSpace(AcceptanceFormName) ? "Selecione acima" : AcceptanceFormName)</b></div><div><small>LEITO / IDADE</small><b>@(string.IsNullOrWhiteSpace(AcceptanceFormBed) ? "—" : AcceptanceFormBed) · @(string.IsNullOrWhiteSpace(AcceptanceFormAge) ? "—" : AcceptanceFormAge)</b></div><label>Data do registro<input type="date" @bind="AcceptanceFormDate" /></label></div>
            </section>
            <section class="acceptance-form-section">
                <h3>02 · Aceitação das refeições</h3>
                <p class="acceptance-help">Selecione se a refeição foi ofertada e, quando ofertada, estime quanto foi consumido. O percentual não é calculado para uma refeição não ofertada.</p>
                <div class="acceptance-meal-grid">
                    @foreach (var meal in AcceptanceMeals)
                    {
                        <div class="acceptance-meal-card">
                            <div class="acceptance-meal-title"><b>@meal.Label</b><strong>@(meal.Offered == "Ofertada" ? meal.Percent + "%" : "—")</strong></div>
                            <label>Oferta<select @bind="meal.Offered"><option>Não informado</option><option>Ofertada</option><option>Não ofertada</option></select></label>
                            @if (meal.Offered == "Ofertada")
                            {
                                <div class="acceptance-percent-options">
                                    @foreach (var percent in new[] { 0, 25, 50, 75, 100 })
                                    {
                                        <button class="@(meal.Percent == percent ? "selected" : "")" @onclick="() => meal.Percent = percent">@percent%</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
            <section class="acceptance-form-section">
                <h3>03 · Suplementação oral</h3>
                <p class="acceptance-help">Registro separado das refeições. Pode ser deixado em branco quando não houver suplemento ofertado.</p>
                <div class="acceptance-supplement-grid"><label>Suplemento<input @bind="AcceptanceFormSupplement" placeholder="Ex.: nome do suplemento" /></label><label>Ofertado?<select @bind="AcceptanceFormSupplementOffered"><option>Não informado</option><option>Sim</option><option>Não</option></select></label></div>
            </section>
            <section class="acceptance-form-section"><h3>04 · Observações</h3><textarea @bind="AcceptanceFormNotes" placeholder="Ex.: inapetência, náuseas, preferência alimentar, sonolência, dificuldades relatadas..."></textarea></section>
        </div>
        <footer class="acceptance-modal-footer"><button class="acceptance-cancel" @onclick="CloseAcceptanceModal">Cancelar</button><button class="acceptance-save" @onclick="SaveAcceptance">Salvar e fechar</button><button class="acceptance-save-next" @onclick="SaveAcceptanceAndNext">Salvar e próximo</button></footer>
    </section>
</div>
}

