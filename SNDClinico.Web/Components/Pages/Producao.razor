                        <div class="snd-page-title-group">

                            <div class="snd-page-title-copy">
                                <h1>Cadastro de alimentos</h1>
                                <p>
                                    Composição nutricional da preparação por 100 g ou 100 ml.
                                    Base para os cálculos das fichas técnicas.
                                </p>
                            </div>
                        </div>

                        <button class="food-new-button" @onclick="AbrirNovoAlimento">
                            <svg viewBox="0 0 24 24">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            Novo alimento
                        </button>
                    </div>

                    <div class="food-toolbar">
                        <div class="food-search">
                            <svg viewBox="0 0 24 24">
                                <circle cx="11" cy="11" r="7" />
                                <path d="m16 16 4 4" />
                            </svg>

                            <input type="search"
                                   placeholder="Buscar alimento"
                                   @bind="Busca"
                                   @bind:event="oninput" />

                            @if (!string.IsNullOrWhiteSpace(Busca))
                            {
                                <button class="food-clear-search"
                                        title="Limpar busca"
                                        @onclick="LimparBusca">
                                    ×
                                </button>
                            }
                        </div>

                        <span class="food-count">
                            @AlimentosFiltrados.Count() alimentos cadastrados
                        </span>
                    </div>

                    <div class="food-table-card">
                        <div class="food-table-scroll">
                            <table class="food-table">
                                <thead>
                                    <tr>
                                        <th>ALIMENTO</th>
                                        <th>UNIDADE</th>
                                        <th>PREÇO</th>
                                        <th>FC</th>
                                        <th>CALORIAS<br />(ENERGIA (KCAL))</th>
                                        <th>CARBOIDRATOS<br />(G)</th>
                                        <th>PROTEÍNAS<br />(G)</th>
                                        <th>LIPÍDIOS<br />(G)</th>
                                        <th>FIBRAS<br />(G)</th>
                                        <th>SÓDIO<br />(MG)</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!AlimentosFiltrados.Any())
                                    {
                                        <tr>
                                            <td colspan="11" class="food-empty">
                                                <div class="food-empty-illustration" aria-hidden="true">
                                                    <svg viewBox="0 0 96 96" role="img">
                                                        <rect x="15" y="18" width="66" height="60" rx="15" fill="#eef6ff" />
                                                        <path d="M32 37h32M32 47h22M32 57h15" fill="none" stroke="#78a7d4" stroke-width="4" stroke-linecap="round" />
                                                        <circle cx="65" cy="63" r="13" fill="#ffffff" stroke="#1478c9" stroke-width="4" />
                                                        <path d="m74 72 8 8" fill="none" stroke="#1478c9" stroke-width="5" stroke-linecap="round" />
                                                        <path d="M47 18v-5M57 20l3-5" fill="none" stroke="#23a477" stroke-width="3" stroke-linecap="round" />
                                                    </svg>
                                                </div>
                                                <strong>@(string.IsNullOrWhiteSpace(Busca) ? "Nenhum alimento cadastrado" : "Nenhum alimento encontrado")</strong>
                                                <span>@(string.IsNullOrWhiteSpace(Busca) ? "Cadastre seu primeiro alimento para começar a montar as fichas técnicas." : "Tente pesquisar por outro nome.")</span>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var alimento in AlimentosFiltrados)
                                        {
                                            <tr @key="alimento.Id">
                                                <td class="food-name">@alimento.Nome</td>
                                                <td class="food-unit">@UnidadeTexto(alimento.Unidade)</td>
                                                <td class="food-price">
                                                    @alimento.Preco.ToString("C2", Cultura)
                                                    <small>/@UnidadePreco(alimento.Unidade)</small>
                                                </td>
                                                <td class="food-correction-factor">@Numero(alimento.FatorCorrecao)</td>
                                                <td>@Numero(alimento.Calorias)</td>
                                                <td>@Numero(alimento.Carboidratos)</td>
                                                <td>@Numero(alimento.Proteinas)</td>
                                                <td>@Numero(alimento.Lipidios)</td>
                                                <td>@Numero(alimento.Fibras)</td>
                                                <td>@Numero(alimento.Sodio)</td>
                                                <td>
                                                    <div class="food-row-actions">
                                                        <button class="food-icon-button edit"
                                                                title="Editar alimento"
                                                                @onclick="() => EditarAlimento(alimento)">
                                                            <svg viewBox="0 0 24 24">
                                                                <path d="m15 5 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4Z" />
                                                            </svg>
                                                        </button>

                                                        <button class="food-icon-button delete"
                                                                title="Excluir alimento"
                                                                @onclick="() => SolicitarExclusao(alimento)">
                                                            <svg viewBox="0 0 24 24">
                                                                <path d="M4 7h16M10 11v6M14 11v6M5 7l1 14h12l1-14M9 7V4h6v3" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="food-table-footer">
                        <span>
                            <span class="food-footer-dot"></span>
                            Valores nutricionais por 100 g ou 100 ml, conforme a unidade cadastrada.
                        </span>
                        <span>Base de dados demonstrativa</span>
                    </div>

                </section>
            }
            else if (secaoSelecionada == "fichas")
            {
                @if (FichaEmEdicao is not null)
                {
                    <section class="recipe-editor-page">
                        <div class="recipe-editor-topbar">
                            <button class="recipe-back-button" @onclick="VoltarParaFichas">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
                                <span>Fichas técnicas</span>
                            </button>
                            <div class="recipe-editor-actions">
                                <button class="recipe-outline-button" @onclick="ImprimirFicha">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M7 14h10v7H7z" /><path d="M17 11h.01" /></svg>
                                    <span>Imprimir</span>
                                </button>
                                <button class="recipe-outline-button danger" @onclick="SolicitarExclusaoFicha">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 14h10l1-14M9 7V4h6v3" /></svg>
                                    <span>Excluir</span>
                                </button>
                            </div>
                        </div>
                        <div class="recipe-editor-layout">
                            <div class="recipe-editor-main">
                                <section class="recipe-panel recipe-identification-panel">
                                    <div class="recipe-form-grid">
                                        <div class="food-form-field recipe-field-wide">
                                            <label>Preparação</label>
                                            <InputText class="food-input" @bind-Value="FichaEmEdicao.Nome" />
                                        </div>
                                        <div class="food-form-field">
                                            <label>Categoria</label>
                                            <InputSelect class="food-input food-select" @bind-Value="FichaEmEdicao.Categoria">
                                                @foreach (var categoria in CategoriasPreparacao)
                                                {
                                                    <option value="@categoria">@categoria</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="food-form-field">
                                            <label>Rendimento final da preparação (g)</label>
                                            <InputNumber class="food-input" @bind-Value="FichaEmEdicao.RendimentoFinalGramas" min="0" />
                                        </div>
                                        <div class="food-form-field">
                                            <label>Quantidade de porções</label>
                                            <InputNumber class="food-input" @bind-Value="FichaEmEdicao.Porcoes" min="1" />
                                        </div>
                                        <div class="food-form-field">
                                            <label>Peso de cada porção (g)</label>
                                            <input class="food-input" value="@Numero(PesoPorPorcao(FichaEmEdicao))" readonly />
                                        </div>
                                        <div class="food-form-field recipe-field-wide">
                                            <label>Modo de preparo / orientações</label>
                                            <InputTextArea class="food-input recipe-preparation-text" @bind-Value="FichaEmEdicao.Observacoes" placeholder="Descreva as etapas de preparo..." />
                                        </div>
                                    </div>
                                    <div class="recipe-editor-note">O rendimento final dividido pelo número de porções determina o peso individual. FC corrige perdas no pré-preparo; FCoc representa a variação de peso durante a cocção.</div>
                                    <div class="recipe-card-footer-actions">
                                        <button type="button" class="food-save-button" @onclick="SalvarEdicaoFicha">Atualizar identificação e rendimento</button>
                                    </div>
                                </section>

                                <section class="recipe-panel">
                                    <div class="recipe-panel-heading"><span class="recipe-panel-dot"></span><strong>Ingredientes</strong></div>
                                    <div class="recipe-editor-table-scroll">
                                        <table class="recipe-editor-table">
                                            <thead><tr><th>INGREDIENTE</th><th>PESO BRUTO</th><th>PESO LÍQUIDO</th><th>FC</th><th>CUSTO DO INGREDIENTE</th><th>ENERGIA (KCAL)</th><th></th></tr></thead>
                                            <tbody>
                                                @foreach (var ingrediente in FichaEmEdicao.Ingredientes)
                                                {
                                                    <tr @key="ingrediente">
                                                        <td><strong>@ingrediente.NomeAlimento</strong></td>
                                                        <td><InputNumber class="recipe-cell-input" @bind-Value="ingrediente.QuantidadeBruta" min="0" /></td>
                                                        <td><InputNumber class="recipe-cell-input" @bind-Value="ingrediente.QuantidadeLiquida" min="0" /></td>
                                                        <td>@Numero(ingrediente.FC)</td>
                                                        <td>@CustoIngredienteReferencia(ingrediente).ToString("C2", Cultura)</td>
                                                        <td>@Numero(KcalIngrediente(ingrediente))</td>
                                                        <td><button class="recipe-remove-ingredient" title="Remover" @onclick="() => RemoverIngredienteEditor(ingrediente)">×</button></td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot><tr><td>Total</td><td>@Numero(FichaEmEdicao.Ingredientes.Sum(i => i.QuantidadeBruta)) g</td><td>@Numero(FichaEmEdicao.Ingredientes.Sum(i => i.QuantidadeLiquida)) g</td><td></td><td>@CustoTotalReferencia(FichaEmEdicao).ToString("C2", Cultura)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "kcal"))</td><td></td></tr></tfoot>
                                        </table>
                                    </div>
                                    <div class="recipe-add-row">
                                        <div class="food-form-field">
                                            <label>Adicionar ingrediente à preparação</label>
                                            <InputSelect class="food-input food-select"
                                                         @bind-Value="AlimentoSelecionadoId"
                                                         @bind-Value:after="AtualizarFatorCorrecaoSelecionado">
                                                <option value="0">Selecione o alimento</option>
                                                @foreach (var alimento in Alimentos.OrderBy(a => a.Nome))
                                                {
                                                    <option value="@alimento.Id">@alimento.Nome</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="food-form-field">
                                            <label>Quantidade bruta (g ou ml)</label>
                                            <InputNumber class="food-input" @bind-Value="QuantidadeBrutaNova" @bind-Value:after="AtualizarLiquidoPeloBruto" min="0.01" />
                                        </div>
                                        <div class="food-form-field">
                                            <label>Quantidade líquida (g ou ml)</label>
                                            <InputNumber class="food-input" @bind-Value="QuantidadeIngrediente" @bind-Value:after="AtualizarBrutoPeloLiquido" min="0.01" />
                                        </div>
                                        <div class="food-form-field recipe-fc-field">
                                            <label>FC cadastrado</label>
                                            <input class="food-input" value="@Numero(FatorCorrecao)" readonly />
                                        </div>
                                        <button class="recipe-add-button" @onclick="AdicionarIngredienteEditor">+ Adicionar</button>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ErroFicha))
                                    {
                                        <div class="food-form-error">@ErroFicha</div>
                                    }
                                </section>
                            </div>

                            <aside class="recipe-editor-aside">
                                <section class="recipe-panel recipe-side-panel">
                                    <div class="recipe-panel-heading"><span class="recipe-panel-dot"></span><strong>Custos</strong></div>
                                    <div class="recipe-cost-line"><span>Custo total de referência</span><strong>@CustoTotalReferencia(FichaEmEdicao).ToString("C2", Cultura)</strong></div>
                                    <div class="recipe-cost-line"><span>Custo total da preparação</span><strong>@CustoTotalReferencia(FichaEmEdicao).ToString("C2", Cultura)</strong></div>
                                    <div class="recipe-cost-line"><span>Custo por porção</span><strong class="highlight">@CustoPorPorcao(FichaEmEdicao).ToString("C2", Cultura)</strong></div>
                                    <div class="recipe-scale-box">
                                        <label>Quantidade de porções a produzir</label>
                                        <InputNumber class="food-input" @bind-Value="QuantidadeProduzir" min="1" />
                                        <small>Custo estimado para a produção</small>
                                        <strong>@((CustoPorPorcao(FichaEmEdicao) * QuantidadeProduzir).ToString("C2", Cultura))</strong>
                                        <small>Dimensionamento proporcional da preparação</small>
                                    </div>
                                </section>
                                <section class="recipe-panel recipe-side-panel">
                                    <div class="recipe-panel-heading"><span class="recipe-panel-dot"></span><strong>Composição nutricional da preparação</strong></div>
                                    <table class="recipe-nutrition-table">
                                        <thead><tr><th>Nutriente</th><th>Total</th><th>Porção</th></tr></thead>
                                        <tbody>
                                            <tr><td>Calorias (kcal)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "kcal"))</td><td>@Numero(KcalPorPorcao(FichaEmEdicao))</td></tr>
                                            <tr><td>Carboidratos (g)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "carboidratos"))</td><td>@Numero(NutrientePorPorcao(FichaEmEdicao, "carboidratos"))</td></tr>
                                            <tr><td>Proteínas (g)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "proteinas"))</td><td>@Numero(NutrientePorPorcao(FichaEmEdicao, "proteinas"))</td></tr>
                                            <tr><td>Lipídios (g)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "lipidios"))</td><td>@Numero(NutrientePorPorcao(FichaEmEdicao, "lipidios"))</td></tr>
                                            <tr><td>Fibras (g)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "fibras"))</td><td>@Numero(NutrientePorPorcao(FichaEmEdicao, "fibras"))</td></tr>
                                            <tr><td>Sódio (mg)</td><td>@Numero(TotalNutriente(FichaEmEdicao, "sodio"))</td><td>@Numero(NutrientePorPorcao(FichaEmEdicao, "sodio"))</td></tr>
                                        </tbody>
                                    </table>
                                </section>
                            </aside>
                        </div>
                        <div class="recipe-editor-savebar">
                            @if (!string.IsNullOrWhiteSpace(ErroFicha))
                            {
                                <div class="food-form-error" role="alert">@ErroFicha</div>
                            }
                            <button type="button" class="food-save-button" @onclick="SalvarEdicaoFicha">Salvar ficha técnica</button>
                        </div>
                    </section>
                }
                else
                {
                    <section class="recipe-page">
                        @if (!string.IsNullOrWhiteSpace(SucessoFicha))
                        {
                            <div class="recipe-success-message" role="status">
                                <span class="recipe-success-icon">✓</span>
                                <div><strong>Ficha técnica salva!</strong><small>@SucessoFicha</small></div>
                                <button type="button" aria-label="Fechar mensagem" @onclick='() => SucessoFicha = ""'>×</button>
                            </div>
                        }
                        <div class="recipe-lovable-hero">
                            <div class="snd-page-title-group">

                                <div class="snd-page-title-copy">
                                    <h1>Fichas técnicas</h1>
                                    <p>Preparações com ingredientes, rendimento, custo e composição nutricional calculados automaticamente.</p>
                                </div>
                            </div>
                            <button class="food-new-button" @onclick="AbrirNovaFicha"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg> Nova ficha técnica</button>
                        </div>
                        <div class="recipe-search-toolbar">
                            <div class="recipe-search-box">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.2 4.2" /></svg>
                                <input type="search" placeholder="Buscar ficha técnica ou preparação..." @bind="BuscaFicha" @bind:event="oninput" />
                                @if (!string.IsNullOrWhiteSpace(BuscaFicha))
                                {
                                    <button type="button" class="recipe-search-clear" title="Limpar busca" @onclick="LimparBuscaFicha">×</button>
                                }
                            </div>
                            <span class="recipe-search-count">@FichasFiltradas.Count() de @Fichas.Count fichas técnicas</span>
                        </div>
                        <div class="recipe-card-grid">
                            @if (!Fichas.Any())
                            {
                                <div class="recipe-empty-state"><img class="recipe-empty-state-icon" src="images/icons/ico_fichas_tecnicas.png" alt="" /><strong>Nenhuma ficha técnica cadastrada</strong><span>Crie sua primeira preparação para começar.</span></div>
                            }
                            else if (!FichasFiltradas.Any())
                            {
                                <div class="recipe-empty-search"><strong>Nenhuma ficha encontrada</strong>Não encontramos preparações com esse termo. Tente outra busca.</div>
                            }
                            else
                            {
                                @foreach (var ficha in FichasFiltradas)
                                {
                                    <button class="recipe-summary-card" @onclick="() => AbrirFicha(ficha)">
                                        <span class="recipe-card-category">@ficha.Categoria</span>
                                        <strong class="recipe-card-name">@ficha.Nome</strong>
                                        <span class="recipe-card-meta">@ficha.Ingredientes.Count ingredientes · @ficha.Porcoes porções de @Numero(PesoPorPorcao(ficha)) g</span>
                                        <span class="recipe-card-divider"></span>
                                        <span class="recipe-card-metrics">
                                            <span><strong>@CustoPorPorcao(ficha).ToString("C2", Cultura)</strong><small>por porção</small></span>
                                            <span><strong>@Numero(KcalPorPorcao(ficha)) kcal</strong><small>por porção</small></span>
                                            <span><strong>@Numero(NutrientePorPorcao(ficha, "proteinas")) g</strong><small>proteínas</small></span>
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                    </section>
                }
            }
            else if (secaoSelecionada == "cardapios")
            {
                <section class="menu-planner-page">
                    <div class="menu-planner-heading">
                        <div class="snd-page-title-group">

                            <div class="snd-page-title-copy">
                                <h1>Planejamento de Cardápios</h1>
                                <p>Organize as refeições da semana e suas preparações por modalidade.</p>
                            </div>
                        </div>
                        <div class="menu-planner-actions">
                            <button type="button" class="menu-action secondary menu-action-copy" title="Copiar todas as refeições e preparações da semana anterior para esta semana" @onclick="CopiarSemanaAnterior">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7v5h5M5.2 12a7 7 0 1 0 2-5" /></svg>
                                <span>Copiar semana anterior</span>
                            </button>
                            <button type="button" class="menu-action secondary menu-action-print" title="Imprimir ou salvar o cardápio em PDF" @onclick="ImprimirCardapio">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7zM17 11h.01" /></svg>
                                <span>Imprimir / PDF</span>
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(MensagemCopiaSemana))
                    {
                        <div class="menu-copy-feedback" role="status">@MensagemCopiaSemana</div>
                    }

                    <div class="menu-toolbar">
                        <div class="menu-toolbar-left">
                            <div class="menu-week-nav menu-period-control">
                                <button title="Semana anterior" @onclick="() => NavegarSemana(-7)">‹</button>
                                <div><strong>@InicioSemana.ToString("dd/MM") – @InicioSemana.AddDays(6).ToString("dd/MM/yyyy")</strong><small>Período de planejamento</small></div>
                                <button title="Próxima semana" @onclick="() => NavegarSemana(7)">›</button>
                                <button class="menu-today" @onclick="IrParaSemanaAtual">Hoje</button>
                            </div>
                            <div class="menu-environment-selector"><label for="ambiente-cardapio">AMBIENTE</label><select id="ambiente-cardapio" class="menu-select" value="@AmbienteCardapio" @onchange="AlterarAmbienteCardapio"><option value="Hospital">Hospital</option><option value="Escolinha">Escolinha infantil</option></select></div>
                            @if (AmbienteCardapio == "Escolinha")
                            {
                                <div class="menu-environment-selector">
                                    <label for="turma-cardapio">TURMA</label><select id="turma-cardapio" class="menu-select" value="@TurmaSelecionada" @onchange="AlterarTurmaCardapio">
                                    @foreach (var turma in TurmasEscolinha.Where(t => t.Ativa))
                                    {
                                        <option value="@turma.Nome">@turma.Nome</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="menu-meal-selector">
                            <label for="meal-select">@(AmbienteCardapio == "Escolinha" ? "VISUALIZAÇÃO" : "REFEIÇÃO")</label>
                            <InputSelect id="meal-select" class="menu-select" @bind-Value="RefeicaoSelecionada">
                                @if (AmbienteCardapio == "Escolinha")
                                {
                                    <option value="Dia todo">Cardápio do dia todo</option>
                                }
                                @foreach (var refeicao in RefeicoesPlanejamento)
                                {
                                    <option value="@refeicao">@refeicao</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                </div>

                <section class="menu-print-settings">
                    <div class="menu-print-settings-heading">
                        <div><strong>Identificação para impressão</strong><small>Personalize o cabeçalho e identifique o nutricionista responsável no documento.</small></div>
                        <span>PDF</span>
                    </div>
                    <div class="menu-print-settings-grid">
                        <label>Nome da instituição / cabeçalho<input @bind="CabecalhoImpressao" placeholder="Ex.: Hospital Municipal" /></label>
                        <label>Texto complementar<input @bind="SubcabecalhoImpressao" placeholder="Ex.: Serviço de Nutrição e Dietética" /></label>
                        <label>Nutricionista responsável<input @bind="NomeNutricionistaResponsavel" placeholder="Nome completo" /></label>
                        <label>CRN<input @bind="CRNResponsavel" placeholder="Ex.: CRN-2 12345" /></label>
                    </div>
                </section>

                @if (AmbienteCardapio == "Hospital")
                {
                    <div class="menu-legend">
