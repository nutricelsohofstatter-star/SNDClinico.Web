                        </div>
                        <div class="stock-table-wrap">
                            <table class="stock-table">
                                <thead><tr><th>DATA E HORÁRIO</th><th>AÇÃO REALIZADA</th><th>LOTE</th><th>QUANTIDADE</th><th>USUÁRIO RESPONSÁVEL</th></tr></thead>
                                <tbody>
                                    @foreach (var movimento in extrato)
                                    {
                                        <tr>
                                            <td>@movimento.Data.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td><strong>@movimento.Tipo</strong></td>
                                            <td>@(string.IsNullOrWhiteSpace(movimento.Lote) ? "—" : movimento.Lote)</td>
                                            <td><span class="stock-status @(movimento.Sinal == "+" ? "success" : "danger")">@movimento.Sinal @movimento.Quantidade.ToString("N2", Pt) @movimento.Unidade</span></td>
                                            <td>@(string.IsNullOrWhiteSpace(movimento.Responsavel) ? "Não informado" : movimento.Responsavel)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="stock-extrato-empty">
                            <span class="stock-extrato-empty-icon">↻</span>
                            <strong>Nenhuma movimentação registrada</strong>
