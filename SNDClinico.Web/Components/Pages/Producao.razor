    private async Task SalvarFicha()
    {
        if (string.IsNullOrWhiteSpace(FichaFormulario.Nome)) { ErroFicha = "Informe o nome da preparação."; return; }
        if (string.IsNullOrWhiteSpace(FichaFormulario.Categoria)) { ErroFicha = "Selecione a categoria da preparação."; return; }
        if (!FichaFormulario.Ingredientes.Any()) { ErroFicha = "Adicione pelo menos um ingrediente."; return; }
        if (FichaFormulario.Porcoes <= 0 || FichaFormulario.RendimentoFinalGramas <= 0) { ErroFicha = "Informe porções e rendimento final maiores que zero."; return; }

        try
        {
            SNDClinico.Web.Data.FichaTecnica entidade;
            if (EditandoFicha && FichaFormulario.Id > 0)
            {
                var fichaExistente = await Db.FichasTecnicas
                    .Include(f => f.Ingredientes)
                    .FirstOrDefaultAsync(f => f.Id == FichaFormulario.Id);

                if (fichaExistente is null)
                {
                    ErroFicha = "A ficha não foi encontrada no banco. Atualize a tela e tente novamente.";
                    await CarregarFichasAsync();
                    return;
                }

                entidade = fichaExistente;
                Db.IngredientesFicha.RemoveRange(entidade.Ingredientes);
                entidade.Ingredientes.Clear();
            }
            else
            {
                entidade = new SNDClinico.Web.Data.FichaTecnica { CriadaEm = DateTime.UtcNow };
                Db.FichasTecnicas.Add(entidade);
            }

            entidade.Nome = FichaFormulario.Nome.Trim();
            entidade.Categoria = FichaFormulario.Categoria;
            entidade.Tipo = FichaFormulario.Tipo ?? "";
            entidade.Observacoes = FichaFormulario.Observacoes;
            entidade.RendimentoFinalGramas = FichaFormulario.RendimentoFinalGramas;
            entidade.Porcoes = FichaFormulario.Porcoes;
            entidade.Ativa = FichaFormulario.Ativa;
            entidade.AtualizadaEm = DateTime.UtcNow;

            var ordem = 0;
            foreach (var item in FichaFormulario.Ingredientes)
            {
                var alimentoExiste = await Db.Alimentos.AnyAsync(a => a.Id == item.AlimentoId);
                if (!alimentoExiste) { ErroFicha = $"O alimento '{item.NomeAlimento}' não existe mais no cadastro. Remova-o e adicione novamente."; return; }
                entidade.Ingredientes.Add(new SNDClinico.Web.Data.IngredienteFicha
                {
                    AlimentoId = item.AlimentoId,
                    NomeAlimentoSnapshot = item.NomeAlimento,
                    Unidade = item.Unidade,
                    QuantidadeLiquida = item.QuantidadeLiquida,
                    QuantidadeBruta = item.QuantidadeBruta,
                    FatorCorrecao = item.FC,
                    PrecoSnapshot = item.PrecoSnapshot,
                    UnidadePrecoSnapshot = item.UnidadePreco,
                    CaloriasSnapshot = item.Calorias,
                    CarboidratosSnapshot = item.Carboidratos,
                    ProteinasSnapshot = item.Proteinas,
                    LipidiosSnapshot = item.Lipidios,
                    FibrasSnapshot = item.Fibras,
                    SodioSnapshot = item.Sodio,
                    UnidadeNutricional = item.UnidadeNutricional,
                    Ordem = ordem++
                });
            }

            await Db.SaveChangesAsync();
            var salva = MapearFichaVm(entidade);
            var indice = Fichas.FindIndex(f => f.Id == salva.Id);
            if (indice >= 0) Fichas[indice] = salva; else Fichas.Add(salva);
            FichaEmEdicao = null;
            FichaFormulario = MapearFichaVm(entidade);
            FichaModalAberto = false;
            ErroFicha = "";
            SucessoFicha = $"A preparação '{salva.Nome}' foi gravada no banco de dados com sucesso.";
        }
        catch (DbUpdateException)
        {
            ErroFicha = "Não foi possível salvar a ficha. Verifique os alimentos vinculados e tente novamente.";
        }
        catch (Exception)
        {
            ErroFicha = "Ocorreu um erro ao salvar a ficha técnica no PostgreSQL.";
        }
    }

    private async Task AlternarFicha(FichaTecnicaVm ficha)
    {
        try
        {
            if (ficha.Id > 0)
            {
                var entidade = await Db.FichasTecnicas.FirstOrDefaultAsync(f => f.Id == ficha.Id);
                if (entidade is null) { ErroFicha = "Ficha não encontrada no banco."; return; }
                entidade.Ativa = !entidade.Ativa;
                entidade.AtualizadaEm = DateTime.UtcNow;
                await Db.SaveChangesAsync();
                ficha.Ativa = entidade.Ativa;
            }
            else ficha.Ativa = !ficha.Ativa;
        }
        catch { ErroFicha = "Não foi possível alterar a situação da ficha."; }
    }

    private async Task CarregarFichasAsync()
    {
        var entidades = await Db.FichasTecnicas
            .AsNoTracking()
            .Include(f => f.Ingredientes)
            .OrderBy(f => f.Nome)
            .ToListAsync();
        Fichas = entidades.Select(MapearFichaVm).ToList();
        ProximoIdFicha = Fichas.Count == 0 ? 1 : Fichas.Max(f => f.Id) + 1;
    }

    private static FichaTecnicaVm MapearFichaVm(SNDClinico.Web.Data.FichaTecnica f) => new()
    {
        Id = f.Id,
        Nome = f.Nome,
        Categoria = f.Categoria,
        Tipo = f.Tipo,
        Observacoes = f.Observacoes ?? "",
        RendimentoFinalGramas = f.RendimentoFinalGramas,
        Porcoes = f.Porcoes,
        Ativa = f.Ativa,
        Ingredientes = f.Ingredientes.OrderBy(i => i.Ordem).Select(i => new IngredienteFichaVm
        {
            AlimentoId = i.AlimentoId,
            NomeAlimento = i.NomeAlimentoSnapshot,
            Unidade = i.Unidade,
            QuantidadeLiquida = i.QuantidadeLiquida,
            QuantidadeBruta = i.QuantidadeBruta,
            FC = i.FatorCorrecao,
            PrecoSnapshot = i.PrecoSnapshot,
            UnidadePreco = i.UnidadePrecoSnapshot,
            Calorias = i.CaloriasSnapshot,
            Carboidratos = i.CarboidratosSnapshot,
            Proteinas = i.ProteinasSnapshot,
            Lipidios = i.LipidiosSnapshot,
            Fibras = i.FibrasSnapshot,
            Sodio = i.SodioSnapshot,
            UnidadeNutricional = i.UnidadeNutricional
        }).ToList()
    };

    private decimal CustoTotalReferencia(FichaTecnicaVm ficha) => ficha.Ingredientes.Sum(CustoIngredienteReferencia);
    private decimal CustoPorPorcao(FichaTecnicaVm ficha) =>
        ficha.Porcoes > 0 ? CustoTotalReferencia(ficha) / ficha.Porcoes : 0m;

    private decimal CustoIngredienteReferencia(IngredienteFichaVm ingrediente)
    {
        var quantidadeBruta = ingrediente.QuantidadeBruta > 0 ? ingrediente.QuantidadeBruta : ingrediente.QuantidadeLiquida * ingrediente.FC;
        return ingrediente.UnidadePreco switch
        {
            "kg" => quantidadeBruta / 1000m * ingrediente.PrecoSnapshot,
            "g" => quantidadeBruta * ingrediente.PrecoSnapshot,
            "l" => quantidadeBruta / 1000m * ingrediente.PrecoSnapshot,
            "ml" => quantidadeBruta * ingrediente.PrecoSnapshot,
            "un" => quantidadeBruta * ingrediente.PrecoSnapshot,
            _ => 0m
        };
    }

    private decimal PesoPorPorcao(FichaTecnicaVm ficha) =>
        ficha.Porcoes > 0 ? ficha.RendimentoFinalGramas / ficha.Porcoes : 0m;

    private decimal TotalNutriente(FichaTecnicaVm ficha, string nutriente) =>
        ficha.Ingredientes.Sum(i =>
        {
            var valor = nutriente switch
            {
                "kcal" => i.Calorias,
                "carboidratos" => i.Carboidratos,
                "proteinas" => i.Proteinas,
                "lipidios" => i.Lipidios,
                "fibras" => i.Fibras,
                "sodio" => i.Sodio,
                _ => 0m
            };
            var fator = i.UnidadeNutricional == "un" ? i.QuantidadeLiquida : i.QuantidadeLiquida / 100m;
            return valor * fator;
        });

    private decimal KcalPorPorcao(FichaTecnicaVm ficha) =>
        ficha.Porcoes > 0 ? TotalNutriente(ficha, "kcal") / ficha.Porcoes : 0m;

    private decimal NutrientePorPorcao(FichaTecnicaVm ficha, string nutriente) =>
        ficha.Porcoes > 0 ? TotalNutriente(ficha, nutriente) / ficha.Porcoes : 0m;

