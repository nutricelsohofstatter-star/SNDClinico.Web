    private void SalvarRecebimento()
    {
        if (string.IsNullOrWhiteSpace(FormRecebimento.Documento)) { Erro = "Informe o documento do almoxarifado."; return; }
        if (string.IsNullOrWhiteSpace(FormRecebimento.Responsavel)) { Erro = "Informe o responsável pela conferência."; return; }
        if (FormRecebimento.ProdutoId <= 0 || !Produtos.Any(p => p.Id == FormRecebimento.ProdutoId && p.Ativo)) { Erro = "Selecione um produto ativo cadastrado."; return; }
        if (string.IsNullOrWhiteSpace(FormRecebimento.Lote)) { Erro = "Informe o código do lote."; return; }
        if (!FormRecebimento.Fabricacao.HasValue) { Erro = "Informe a data de fabricação."; return; }
        if (FormRecebimento.Validade == default) { Erro = "Informe a validade do lote."; return; }
        if (!FormRecebimento.Entregue.HasValue || FormRecebimento.Entregue.Value <= 0 || !FormRecebimento.Aceita.HasValue || !FormRecebimento.Recusada.HasValue || FormRecebimento.Aceita.Value < 0 || FormRecebimento.Recusada.Value < 0) { Erro = "Informe as três quantidades. Quando não houver recusa ou aceite, informe 0."; return; }
        if (FormRecebimento.Aceita.Value + FormRecebimento.Recusada.Value != FormRecebimento.Entregue.Value) { Erro = "As quantidades aceitas e recusadas devem corresponder à quantidade entregue."; return; }
        if (FormRecebimento.Fabricacao.Value.Date > FormRecebimento.Validade.Date) { Erro = "A data de fabricação não pode ser posterior à validade."; return; }
        var p = Produtos.First(x => x.Id == FormRecebimento.ProdutoId);
        var codigo = $"REC-{DateTime.Today:yyyy}-{Recebimentos.Count + 1:0000}";
        var loteCodigo = FormRecebimento.Lote.Trim();
        if (FormRecebimento.Aceita.Value > 0)
        {
            Lotes.Add(new Lote { Id = ProximoLoteId++, ProdutoId = p.Id, ProdutoNome = p.Nome, Codigo = loteCodigo, Validade = FormRecebimento.Validade, Fabricacao = FormRecebimento.Fabricacao, Quantidade = FormRecebimento.Aceita.Value, Unidade = p.UnidadeMedida, CustoUnitario = FormRecebimento.CustoUnitario, Local = p.Local });
            Movimentacoes.Add(new() { Data = DateTime.Now, ProdutoId = p.Id, Tipo = "Entrada por recebimento", Produto = p.Nome, Lote = loteCodigo, Quantidade = FormRecebimento.Aceita.Value, Unidade = p.UnidadeMedida, Sinal = "+", Responsavel = FormRecebimento.Responsavel, Observacao = FormRecebimento.Observacao });
        }
        Recebimentos.Add(new() { Codigo = codigo, Documento = FormRecebimento.Documento, Data = DateTime.Now, Aceitos = FormRecebimento.Aceita.Value, Recusados = FormRecebimento.Recusada.Value });
        if (FormRecebimento.Recusada.Value > 0) Movimentacoes.Add(new() { Data = DateTime.Now, ProdutoId = p.Id, Tipo = "Recusa no recebimento", Produto = p.Nome, Lote = loteCodigo, Quantidade = FormRecebimento.Recusada.Value, Unidade = p.UnidadeMedida, Sinal = "×", Responsavel = FormRecebimento.Responsavel, Observacao = "Item recusado na conferência. " + FormRecebimento.Observacao });
        FecharModalRecebimento();
    }
