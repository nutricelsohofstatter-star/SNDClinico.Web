    private int Percentual(int valor, int total) => total <= 0 ? 0 : (int)Math.Round((decimal)valor / total * 100m, MidpointRounding.AwayFromZero);
    private IEnumerable<(string Modalidade, int Quantidade, decimal Custo)> ResumoModalidadesSemana =>
        ModalidadesCardapio.Select(m => (Modalidade: m, Planos: PlanosSemanaRelatorio.Where(p => p.Modalidade == m).ToList()))
            .Select(x => (x.Modalidade, Quantidade: x.Planos.Sum(QuantidadeRelatorio), Custo: x.Planos.Sum(p => p.Preparacoes.Sum(CustoEfetivoPreparacao) * QuantidadeRelatorio(p))))
            .Where(x => x.Quantidade > 0 || x.Custo > 0);
    private IEnumerable<(string Refeicao, decimal Custo)> ResumoRefeicoesSemana =>
        RefeicoesPlanejamento.Select(r => (Refeicao: r, Custo: PlanosSemanaRelatorio.Where(p => p.Refeicao == r).Sum(p => p.Preparacoes.Sum(CustoEfetivoPreparacao) * QuantidadeRelatorio(p))))
            .Where(x => x.Custo > 0);
    private IEnumerable<(string Nome, int Usos, decimal CustoUnitario)> PreparacoesMaisUsadas =>
        PlanosSemanaRelatorio.SelectMany(p => p.Preparacoes)
            .GroupBy(p => p.Nome)
            .Select(g => (Nome: g.Key, Usos: g.Count(), CustoUnitario: g.Select(CustoEfetivoPreparacao).DefaultIfEmpty(0m).Average()))
            .OrderByDescending(x => x.Usos).Take(6);
    private IEnumerable<(string Refeicao, int Quantidade)> ResumoProducaoRefeicoes =>
        RefeicoesPlanejamento.Select(r => (Refeicao: r, Quantidade: PlanosSemanaRelatorio.Where(p => p.Refeicao == r).Sum(QuantidadeRelatorio)))
            .Where(x => x.Quantidade > 0).OrderByDescending(x => x.Quantidade);
    private IEnumerable<(string Nome, decimal Custo)> PreparacoesMaisCustosas =>
        PlanosSemanaRelatorio.SelectMany(p => p.Preparacoes)
            .GroupBy(p => p.Nome)
            .Select(g => (Nome: g.Key, Custo: g.Select(CustoEfetivoPreparacao).DefaultIfEmpty(0m).Max()))
            .OrderByDescending(x => x.Custo).Take(5);
    private IEnumerable<(string Ingrediente, int Utilizacoes, decimal Economia)> ResumoDoacoesIngredientes =>
        PlanosSemanaRelatorio.SelectMany(p => p.Preparacoes.SelectMany(prep =>
        {
            var ficha = ObterFicha(prep);
            if (ficha is null || ficha.Porcoes <= 0) return Enumerable.Empty<(string Ingrediente, int Utilizacoes, decimal Economia)>();
            return ficha.Ingredientes.Where(i => prep.IngredientesDoados.Contains(i.AlimentoId))
                .Select(i => (Ingrediente: i.NomeAlimento, Utilizacoes: QuantidadeRelatorio(p), Economia: (CustoIngredienteReferencia(i) / ficha.Porcoes) * QuantidadeRelatorio(p)));
        }))
        .GroupBy(x => x.Ingrediente)
        .Select(g => (Ingrediente: g.Key, Utilizacoes: g.Sum(x => x.Utilizacoes), Economia: g.Sum(x => x.Economia)))
        .OrderByDescending(x => x.Economia);

