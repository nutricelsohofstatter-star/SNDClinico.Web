    private void DefinirPeriodoRelatorio(string periodo)
    {
        PeriodoRelatorio = periodo;
        var hoje = DateTime.Today;
        if (periodo == "Hoje") { DataInicialFiltroRelatorio = hoje; DataFinalFiltroRelatorio = hoje; }
        else if (periodo == "Semana atual") { DataInicialFiltroRelatorio = SegundaFeira(hoje); DataFinalFiltroRelatorio = hoje; }
        else if (periodo == "Mês atual") { DataInicialFiltroRelatorio = new DateTime(hoje.Year, hoje.Month, 1); DataFinalFiltroRelatorio = hoje; }
        else if (periodo == "Ano atual") { DataInicialFiltroRelatorio = new DateTime(hoje.Year, 1, 1); DataFinalFiltroRelatorio = hoje; }
    }

