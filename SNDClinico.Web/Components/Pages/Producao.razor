    private string ChaveQuantidadeRelatorio(DateTime dia, string refeicao, string modalidade, string escopo) => $"{dia:yyyyMMdd}|{refeicao}|{modalidade}|{escopo}";
    private int QuantidadeRelatorio(PlanoRefeicao plano) => QuantidadesProduzidas.TryGetValue(ChaveQuantidadeRelatorio(plano.Dia, plano.Refeicao, plano.Modalidade, plano.Escopo), out var qtd) ? qtd : 0;
    private decimal CustoDoadoPreparacao(PreparacaoPlanejada prep)
    {
        var ficha = ObterFicha(prep);
        if (ficha is null || ficha.Porcoes <= 0) return 0m;
        return ficha.Ingredientes.Where(i => prep.IngredientesDoados.Contains(i.AlimentoId)).Sum(CustoIngredienteReferencia) / ficha.Porcoes;
    }
    private decimal CustoEfetivoPreparacao(PreparacaoPlanejada prep) => CustoUnitarioPreparacao(prep);
    private IEnumerable<PlanoRefeicao> PlanosSemanaRelatorio => PlanosCardapio.Values.Where(p => p.Escopo == "Geral" && p.Dia.Date >= InicioSemana.Date && p.Dia.Date <= InicioSemana.AddDays(6).Date);
    private int TotalProduzidoSemana => PlanosSemanaRelatorio.Sum(QuantidadeRelatorio);
    private int TotalPreparacoesSemana => PlanosSemanaRelatorio.Sum(p => p.Preparacoes.Count);
    private decimal CustoEfetivoSemana => PlanosSemanaRelatorio.Sum(p => p.Preparacoes.Sum(prep => CustoEfetivoPreparacao(prep)) * QuantidadeRelatorio(p));
    private decimal EconomiaDoacoesSemana => PlanosSemanaRelatorio.Sum(p => p.Preparacoes.Sum(CustoDoadoPreparacao) * QuantidadeRelatorio(p));
    private decimal CustoUnitarioPlano(PlanoRefeicao plano) => plano.Preparacoes.Sum(CustoEfetivoPreparacao);
    private decimal CustoMedioUnidadeSemana => TotalProduzidoSemana > 0 ? CustoEfetivoSemana / TotalProduzidoSemana : 0m;
    private IEnumerable<(DateTime Dia, string Refeicao, string Modalidade, int Quantidade, decimal CustoUnitario, decimal CustoTotal)> DetalhamentoCustoDiario =>
        PlanosSemanaRelatorio.Where(p => p.Preparacoes.Count > 0 && QuantidadeRelatorio(p) > 0)
