                    </div>
                }
            </div>
            <footer class="stock-dialog-footer">
                <span class="stock-dialog-required">Extrato de movimentações · SND Produção</span>
                <div class="stock-dialog-footer-actions"><button type="button" class="stock-secondary" @onclick="() => ModalExtratoItem = false">Fechar</button></div>
            </footer>
        </section>
    </div>
}

