    private void NovoInventario() { InventarioAberto = true; DataInventario = DateTime.Today; Contagens = Produtos.ToDictionary(p => p.Id, p => SaldoFisico(p.Id)); }
    private void FinalizarInventario()
    {
        DivergenciasPendentes.Clear();
        foreach (var p in Produtos)
        {
            var sistema = SaldoFisico(p.Id); var contagem = Contagens.TryGetValue(p.Id, out var c) ? c : 0;
            if (contagem != sistema) DivergenciasPendentes.Add(new() { ProdutoId = p.Id, Produto = p.Nome, Sistema = sistema, Contagem = contagem, Diferenca = contagem - sistema });
        }
        Inventarios.Add(new() { Data = DateTime.Now, Tipo = "Extraordinário", Itens = Produtos.Count, Divergencias = DivergenciasPendentes.Count });
        InventarioAberto = false;
    }
    private void AplicarAjuste(Divergencia d)
    {
        if (string.IsNullOrWhiteSpace(d.Justificativa)) { Erro = "A justificativa é obrigatória para ajustar o inventário."; return; }
        var diferenca = d.Diferenca;
        if (diferenca < 0)
        {
            var restante = Math.Abs(diferenca);
            foreach (var lote in Lotes.Where(x => x.ProdutoId == d.ProdutoId).OrderByDescending(x => x.Validade))
            {
                var baixa = Math.Min(restante, lote.Quantidade); lote.Quantidade -= baixa; restante -= baixa; if (restante <= 0) break;
            }
        }
        else if (diferenca > 0)
        {
            // Acréscimo sem lote rastreável não é permitido: requer conferência de lote/validade.
            Erro = "Para diferença positiva, cadastre o lote e a validade por meio de um recebimento de ajuste antes de confirmar."; return;
        }
        Movimentacoes.Add(new() { Data = DateTime.Now, ProdutoId = d.ProdutoId, Tipo = "Ajuste de inventário", Produto = d.Produto, Quantidade = Math.Abs(diferenca), Unidade = Produtos.First(x => x.Id == d.ProdutoId).UnidadeMedida, Sinal = diferenca < 0 ? "−" : "+", Responsavel = "Responsável do SND", Observacao = d.Justificativa });
        DivergenciasPendentes.Remove(d);
    }

