    private void AdicionarTurmaEscolinha()
    {
        var nome = NovaTurmaNome.Trim();
        var faixa = NovaTurmaFaixa.Trim();
        if (nome.Length == 0 || faixa.Length == 0) return;
        if (TurmasEscolinha.Any(t => t.Nome.Equals(nome, StringComparison.OrdinalIgnoreCase))) return;

        TurmasEscolinha.Add(new TurmaEscolinha
        {
            Nome = nome,
            FaixaEtaria = faixa
        });

        NovaTurmaNome = "";
        NovaTurmaFaixa = "";
    }

    private void RemoverTurmaEscolinha(TurmaEscolinha turma)
    {
        if (turma is null) return;

        TurmasEscolinha.Remove(turma);

        if (TurmaSelecionada == turma.Nome)
        {
            TurmaSelecionada = TurmasEscolinha.FirstOrDefault(t => t.Ativa)?.Nome ?? "";
            EscopoCardapio = "Escolinha|" + TurmaSelecionada;
        }
    }

    private static string ChavePlano(DateTime dia, string refeicao, string modalidade, string escopo) => $"{dia:yyyyMMdd}|{refeicao}|{modalidade}|{escopo}";
    private string ChavePlano(DateTime dia, string refeicao, string modalidade) => ChavePlano(dia, refeicao, modalidade, EscopoCardapio);
    private string NomeDia(DateTime dia) => dia.ToString("dddd", Cultura).ToUpperInvariant();
    private string ClasseModalidade(string modalidade) => modalidade.ToLowerInvariant() switch { "particular" => "particular", "dm" => "dm", "pastosa" => "pastosa", _ => "sus" };
    private int QuantidadeGeral(string refeicao) => PlanosCardapio.Values.Where(p => p.Refeicao == refeicao && p.Escopo == EscopoCardapio).Select(p => p.QuantidadeGeral).DefaultIfEmpty(100).Max();
    private string ChaveQuantidade(DateTime dia, string refeicao, string modalidade) => $"{dia:yyyyMMdd}|{refeicao}|{modalidade}|{EscopoCardapio}";
    private string ChaveQuantidade(DateTime dia, string modalidade) => ChaveQuantidade(dia, RefeicaoSelecionada, modalidade);
    private int QuantidadeProduzida(DateTime dia, string modalidade) => QuantidadeProduzida(dia, RefeicaoSelecionada, modalidade);
    private int QuantidadeProduzida(DateTime dia, string refeicao, string modalidade) => QuantidadesProduzidas.TryGetValue(ChaveQuantidade(dia, refeicao, modalidade), out var quantidade) ? quantidade : 0;
    private void DefinirQuantidadeProduzida(DateTime dia, string modalidade, ChangeEventArgs e) => DefinirQuantidadeProduzida(dia, RefeicaoSelecionada, modalidade, e);
    private void DefinirQuantidadeProduzida(DateTime dia, string refeicao, string modalidade, ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var valor)) QuantidadesProduzidas[ChaveQuantidade(dia, refeicao, modalidade)] = Math.Max(0, valor); }
    private PlanoRefeicao ObterPlano(DateTime dia, string refeicao, string modalidade)
    {
        var chave = ChavePlano(dia, refeicao, modalidade);
        if (PlanosCardapio.TryGetValue(chave, out var existente)) return existente;
        if (AmbienteCardapio == "Hospital" && EscopoCardapio != "Geral" && PlanosCardapio.TryGetValue(ChavePlano(dia, refeicao, modalidade, "Geral"), out var baseGeral))
            return new PlanoRefeicao { Dia = dia, Refeicao = refeicao, Modalidade = modalidade, Escopo = EscopoCardapio, QuantidadeGeral = baseGeral.QuantidadeGeral, Preparacoes = baseGeral.Preparacoes.Select(x => x.Clone()).ToList(), Herdado = true };
        return new PlanoRefeicao { Dia = dia, Refeicao = refeicao, Modalidade = modalidade, Escopo = EscopoCardapio, QuantidadeGeral = 100, Herdado = false };
    }

    private async Task NavegarSemana(int dias) { InicioSemana = InicioSemana.AddDays(dias); MensagemCopiaSemana = ""; await CarregarCardapiosSemanaAsync(); }
    private async Task IrParaSemanaAtual() { InicioSemana = SegundaFeira(DateTime.Today); MensagemCopiaSemana = ""; await CarregarCardapiosSemanaAsync(); }
    private async Task AtualizarEscopo() => await CarregarCardapiosSemanaAsync();

    private void AbrirEdicaoCardapio(DateTime dia, string refeicao, string modalidade)
    {
        DiaEmEdicao = dia; RefeicaoEmEdicao = refeicao; ModalidadeEmEdicao = modalidade; EscopoEmEdicao = EscopoCardapio;
        var plano = ObterPlano(dia, refeicao, modalidade);
        PreparacoesEdicao = plano.Preparacoes.Select(x => x.Clone()).ToList();
        QuantidadeGeralEdicao = plano.QuantidadeGeral;
        UsarBaseGeral = plano.Herdado;
        FichaParaAdicionarId = 0;
        ModalCardapioAberto = true;
    }

    private void AbrirEdicaoRapida() => AbrirEdicaoCardapio(InicioSemana, RefeicaoSelecionada == "Dia todo" ? (RefeicoesPlanejamento.FirstOrDefault() ?? "Almoço") : RefeicaoSelecionada, ModalidadesAtivas.FirstOrDefault() ?? "SUS");

    private void AdicionarPreparacao()
    {
        var ficha = Fichas.FirstOrDefault(f => f.Id == FichaParaAdicionarId && f.Ativa);
        if (ficha is null || PreparacoesEdicao.Any(x => x.FichaId == ficha.Id)) return;
        PreparacoesEdicao.Add(new PreparacaoPlanejada { FichaId = ficha.Id, Nome = ficha.Nome, Porcoes = 0, PesoPorPorcao = PesoPorPorcao(ficha), Herdada = false });
        FichaParaAdicionarId = 0;
    }

    private FichaTecnicaVm? ObterFicha(PreparacaoPlanejada prep) => Fichas.FirstOrDefault(x => x.Id == prep.FichaId);

    private void AlternarDoacaoIngrediente(PreparacaoPlanejada prep, int alimentoId, ChangeEventArgs e)
    {
        var marcado = e.Value is bool valor && valor;
        if (marcado && !prep.IngredientesDoados.Contains(alimentoId)) prep.IngredientesDoados.Add(alimentoId);
        else if (!marcado) prep.IngredientesDoados.Remove(alimentoId);
    }

    private decimal CustoUnitarioPreparacao(PreparacaoPlanejada prep)
    {
        var ficha = ObterFicha(prep);
        if (ficha is null || ficha.Porcoes <= 0) return 0m;
        var custo = ficha.Ingredientes.Where(i => !prep.IngredientesDoados.Contains(i.AlimentoId)).Sum(CustoIngredienteReferencia);
        return custo / ficha.Porcoes;
    }

    private decimal CustoUnitarioRefeicao() => PreparacoesEdicao.Sum(CustoUnitarioPreparacao);

    private void RemoverPreparacao(PreparacaoPlanejada prep) => PreparacoesEdicao.Remove(prep);

    private async Task SalvarEdicaoCardapio()
    {
        var chave = ChavePlano(DiaEmEdicao, RefeicaoEmEdicao, ModalidadeEmEdicao, EscopoEmEdicao);
        var herdarBase = AmbienteCardapio == "Hospital" && EscopoEmEdicao != "Geral" && UsarBaseGeral;
        var plano = new PlanoRefeicao
        {
            Dia = DiaEmEdicao,
            Refeicao = RefeicaoEmEdicao,
            Modalidade = ModalidadeEmEdicao,
            Escopo = EscopoEmEdicao,
            QuantidadeGeral = Math.Max(0, QuantidadeGeralEdicao),
            Preparacoes = PreparacoesEdicao.Select(x => x.Clone()).ToList(),
            Herdado = false
        };

        try
        {
            await SalvarPlanoCardapioNoBancoAsync(plano, herdarBase);
            if (herdarBase) PlanosCardapio.Remove(chave);
            else PlanosCardapio[chave] = plano;
            ModalCardapioAberto = false;
            ErroCardapio = "";
        }
        catch (DbUpdateException)
        {
            ErroCardapio = "Não foi possível gravar o cardápio. Confira se as fichas técnicas e modalidades continuam cadastradas.";
        }
        catch (Exception)
        {
            ErroCardapio = "Ocorreu um erro ao salvar o planejamento no PostgreSQL.";
        }
    }

    private void FecharEdicaoCardapio() => ModalCardapioAberto = false;

    private string MensagemCopiaSemana = "";
    private string ErroCardapio = "";

    private async Task CopiarSemanaAnterior()
    {
        var origem = InicioSemana.AddDays(-7);
        var inicioOrigem = DateOnly.FromDateTime(origem.Date);
        var fimOrigem = DateOnly.FromDateTime(origem.AddDays(6).Date);
        var modalidadesParaCopiar = ModalidadesAtivas.ToList();
        var planosAnteriores = await Db.Cardapios.AsNoTracking()
            .Include(c => c.ModalidadeCardapio)
            .Include(c => c.Refeicoes).ThenInclude(r => r.Preparacoes).ThenInclude(p => p.IngredientesDoados)
            .Where(c => c.Escopo == EscopoCardapio && modalidadesParaCopiar.Contains(c.ModalidadeCardapio!.Nome) && c.DataInicio <= fimOrigem && c.DataFim >= inicioOrigem)
            .ToListAsync();
        foreach (var cardapioAnterior in planosAnteriores)
        {
            var modalidadeAnterior = cardapioAnterior.ModalidadeCardapio?.Nome;
            if (string.IsNullOrWhiteSpace(modalidadeAnterior)) continue;
            foreach (var refeicaoAnterior in cardapioAnterior.Refeicoes)
            {
                var diaAnterior = refeicaoAnterior.Data.ToDateTime(TimeOnly.MinValue);
                if (diaAnterior.Date < origem.Date || diaAnterior.Date > origem.AddDays(6).Date) continue;
                PlanosCardapio[ChavePlano(diaAnterior, refeicaoAnterior.Nome, modalidadeAnterior, EscopoCardapio)] = new PlanoRefeicao
                {
                    Dia = diaAnterior,
                    Refeicao = refeicaoAnterior.Nome,
                    Modalidade = modalidadeAnterior,
                    Escopo = EscopoCardapio,
                    QuantidadeGeral = refeicaoAnterior.QuantidadePrevista,
                    Preparacoes = refeicaoAnterior.Preparacoes.OrderBy(p => p.Ordem).Select(p => new PreparacaoPlanejada
                    {
                        FichaId = p.FichaTecnicaId,
                        Nome = p.NomeSnapshot,
                        Porcoes = p.Porcoes,
                        PesoPorPorcao = p.PesoPorPorcao,
                        Herdada = p.Herdada,
                        IngredientesDoados = p.IngredientesDoados.Select(i => i.AlimentoId).ToList()
                    }).ToList()
                };
            }
        }
        var copiados = 0;

        foreach (var diaOffset in Enumerable.Range(0, 7))
        {
            foreach (var refeicao in RefeicoesPlanejamento)
            {
                foreach (var modalidade in modalidadesParaCopiar)
                {
                    var dataOrigem = origem.AddDays(diaOffset);
                    if (!PlanosCardapio.TryGetValue(ChavePlano(dataOrigem, refeicao, modalidade, EscopoCardapio), out var origemPlano))
                        continue;

                    var destino = InicioSemana.AddDays(diaOffset);
                    var planoCopiado = new PlanoRefeicao
                    {
                        Dia = destino,
                        Refeicao = refeicao,
                        Modalidade = modalidade,
                        Escopo = EscopoCardapio,
                        QuantidadeGeral = origemPlano.QuantidadeGeral,
                        Preparacoes = origemPlano.Preparacoes.Select(x => x.Clone()).ToList(),
                        Herdado = false
                    };
                    await SalvarPlanoCardapioNoBancoAsync(planoCopiado, false);
                    PlanosCardapio[ChavePlano(destino, refeicao, modalidade, EscopoCardapio)] = planoCopiado;
                    copiados++;
                }
            }
        }

        MensagemCopiaSemana = copiados > 0
            ? $"{copiados} planejamento(s) copiado(s) da semana anterior. Confira os dados antes de utilizar."
            : string.Empty;
    }

    private async Task GarantirModalidadesCardapioAsync()
    {
        var existentes = await Db.ModalidadesCardapio.ToListAsync();
        foreach (var nome in ModalidadesCardapio)
        {
            if (!existentes.Any(m => string.Equals(m.Nome, nome, StringComparison.OrdinalIgnoreCase)))
                Db.ModalidadesCardapio.Add(new SNDClinico.Web.Data.ModalidadeCardapio { Nome = nome, Ativa = true });
        }
        if (Db.ChangeTracker.HasChanges()) await Db.SaveChangesAsync();
    }

    private async Task CarregarCardapiosSemanaAsync()
    {
        var inicio = DateOnly.FromDateTime(InicioSemana.Date);
        var fim = DateOnly.FromDateTime(InicioSemana.AddDays(6).Date);
        var escopos = AmbienteCardapio == "Hospital" && EscopoCardapio != "Geral"
            ? new[] { EscopoCardapio, "Geral" }
            : new[] { EscopoCardapio };

        var entidades = await Db.Cardapios.AsNoTracking()
            .Include(c => c.ModalidadeCardapio)
            .Include(c => c.Refeicoes).ThenInclude(r => r.Preparacoes).ThenInclude(p => p.IngredientesDoados)
            .Where(c => escopos.Contains(c.Escopo) && c.DataInicio <= fim && c.DataFim >= inicio)
            .ToListAsync();

        foreach (var chave in PlanosCardapio.Keys.Where(k => k.Contains("|" + EscopoCardapio, StringComparison.Ordinal) || (AmbienteCardapio == "Hospital" && k.EndsWith("|Geral", StringComparison.Ordinal))).ToList())
            PlanosCardapio.Remove(chave);

        foreach (var cardapio in entidades.OrderBy(c => c.CriadoEm))
        {
            var modalidade = cardapio.ModalidadeCardapio?.Nome;
            if (string.IsNullOrWhiteSpace(modalidade)) continue;
            foreach (var refeicao in cardapio.Refeicoes.OrderBy(r => r.Data).ThenBy(r => r.Ordem))
            {
                var dia = refeicao.Data.ToDateTime(TimeOnly.MinValue);
                if (dia.Date < InicioSemana.Date || dia.Date > InicioSemana.AddDays(6).Date) continue;
                var plano = new PlanoRefeicao
                {
                    Dia = dia,
                    Refeicao = refeicao.Nome,
                    Modalidade = modalidade,
                    Escopo = cardapio.Escopo,
                    QuantidadeGeral = refeicao.QuantidadePrevista,
                    Herdado = false,
                    Preparacoes = refeicao.Preparacoes.OrderBy(p => p.Ordem).Select(p => new PreparacaoPlanejada
                    {
                        FichaId = p.FichaTecnicaId,
                        Nome = p.NomeSnapshot,
                        Porcoes = p.Porcoes,
                        PesoPorPorcao = p.PesoPorPorcao,
                        Herdada = p.Herdada,
                        IngredientesDoados = p.IngredientesDoados.Select(i => i.AlimentoId).ToList()
                    }).ToList()
                };
                PlanosCardapio[ChavePlano(dia, refeicao.Nome, modalidade, cardapio.Escopo)] = plano;
            }
        }
    }

    private async Task SalvarPlanoCardapioNoBancoAsync(PlanoRefeicao plano, bool herdarBase)
    {
        var inicio = DateOnly.FromDateTime(InicioSemana.Date);
        var fim = DateOnly.FromDateTime(InicioSemana.AddDays(6).Date);
        var modalidade = await Db.ModalidadesCardapio.FirstOrDefaultAsync(m => m.Nome == plano.Modalidade);
        if (modalidade is null)
        {
            modalidade = new SNDClinico.Web.Data.ModalidadeCardapio { Nome = plano.Modalidade, Ativa = true };
            Db.ModalidadesCardapio.Add(modalidade);
            await Db.SaveChangesAsync();
        }

        var cardapio = await Db.Cardapios
            .Include(c => c.Refeicoes).ThenInclude(r => r.Preparacoes).ThenInclude(p => p.IngredientesDoados)
            .FirstOrDefaultAsync(c => c.Escopo == plano.Escopo && c.ModalidadeCardapioId == modalidade.Id && c.DataInicio == inicio && c.DataFim == fim);

        SNDClinico.Web.Data.Cardapio? cardapioBase = null;
        if (AmbienteCardapio == "Hospital" && plano.Escopo != "Geral")
        {
            cardapioBase = await Db.Cardapios.FirstOrDefaultAsync(c => c.Escopo == "Geral" && c.ModalidadeCardapioId == modalidade.Id && c.DataInicio == inicio && c.DataFim == fim);
            if (cardapioBase is null)
            {
                cardapioBase = new SNDClinico.Web.Data.Cardapio
                {
                    Nome = $"Cardápio Geral - {plano.Modalidade} - {InicioSemana:dd/MM/yyyy}",
                    Escopo = "Geral",
                    ModalidadeCardapioId = modalidade.Id,
                    DataInicio = inicio,
                    DataFim = fim,
                    Ativo = true,
                    CriadoEm = DateTime.UtcNow
                };
                Db.Cardapios.Add(cardapioBase);
                await Db.SaveChangesAsync();
            }
        }

        if (cardapio is null)
        {
            cardapio = new SNDClinico.Web.Data.Cardapio
            {
                Nome = $"{(plano.Escopo == "Geral" ? "Cardápio Geral" : plano.Escopo)} - {plano.Modalidade} - {InicioSemana:dd/MM/yyyy}",
                Escopo = plano.Escopo,
                ModalidadeCardapioId = modalidade.Id,
                DataInicio = inicio,
                DataFim = fim,
                Ativo = true,
                CriadoEm = DateTime.UtcNow
            };
            Db.Cardapios.Add(cardapio);
        }
        cardapio.CardapioBaseId = herdarBase ? cardapioBase?.Id : null;
        if (herdarBase)
        {
            // O cardápio derivado permanece registrado, mas sem refeições próprias:
            // a tela consulta a base geral e permite personalização futura sem alterá-la.
            Db.RefeicoesCardapio.RemoveRange(cardapio.Refeicoes);
            cardapio.Refeicoes.Clear();
        }
        else
        {
            var dataRefeicao = DateOnly.FromDateTime(plano.Dia.Date);
            var refeicoesSubstituidas = cardapio.Refeicoes
                .Where(r => r.Data == dataRefeicao && r.Nome == plano.Refeicao)
                .ToList();
            Db.RefeicoesCardapio.RemoveRange(refeicoesSubstituidas);
            foreach (var refeicaoAntiga in refeicoesSubstituidas) cardapio.Refeicoes.Remove(refeicaoAntiga);

            cardapio.Refeicoes.Add(new SNDClinico.Web.Data.RefeicaoCardapio
            {
                Data = dataRefeicao,
                Nome = plano.Refeicao,
                QuantidadePrevista = Math.Max(0, plano.QuantidadeGeral),
                Ordem = Math.Max(0, RefeicoesPlanejamento.IndexOf(plano.Refeicao)),
                Preparacoes = plano.Preparacoes.Select((prep, index) => new SNDClinico.Web.Data.PreparacaoCardapio
                {
                    FichaTecnicaId = prep.FichaId,
                    NomeSnapshot = prep.Nome,
                    Porcoes = Math.Max(0, prep.Porcoes),
                    PesoPorPorcao = prep.PesoPorPorcao,
                    Herdada = prep.Herdada,
                    Ordem = index,
                    IngredientesDoados = prep.IngredientesDoados.Distinct().Select(id => new SNDClinico.Web.Data.IngredienteDoadoPreparacao { AlimentoId = id }).ToList()
                }).ToList()
            });
        }

        await Db.SaveChangesAsync();
    }

