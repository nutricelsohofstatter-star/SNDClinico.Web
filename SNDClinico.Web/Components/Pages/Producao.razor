    private async Task AlterarAmbienteCardapio(ChangeEventArgs e)
    {
        AmbienteCardapio = e.Value?.ToString() == "Escolinha" ? "Escolinha" : "Hospital";
        if (AmbienteCardapio == "Escolinha")
        {
            if (!TurmasEscolinha.Any(t => t.Ativa && t.Nome == TurmaSelecionada)) TurmaSelecionada = TurmasEscolinha.FirstOrDefault(t => t.Ativa)?.Nome ?? "";
            EscopoCardapio = "Escolinha|" + TurmaSelecionada;
            RefeicaoSelecionada = "Dia todo";
        }
        else
        {
            EscopoCardapio = "Geral";
            if (RefeicaoSelecionada == "Dia todo") RefeicaoSelecionada = "Almoço";
        }
        await CarregarCardapiosSemanaAsync();
