    private void AdicionarIngrediente()
    {
        var alimento = Alimentos.FirstOrDefault(a => a.Id == AlimentoSelecionadoId);
        if (alimento is null) { ErroFicha = "Selecione um alimento cadastrado."; return; }
        if (QuantidadeIngrediente <= 0 || FatorCorrecao <= 0) { ErroFicha = "Informe uma quantidade líquida e um FC maiores que zero."; return; }
        var unidade = alimento.Unidade is "l" or "ml" ? "ml" : alimento.Unidade == "un" ? "un" : "g";
        if (unidade != UnidadeIngrediente)
        {
            ErroFicha = unidade == "un" ? "Este alimento está cadastrado por unidade. Utilize a unidade 'un'." : unidade == "ml" ? "Este alimento está cadastrado por volume. Utilize 'ml'." : "Este alimento está cadastrado por peso. Utilize 'g'.";
            return;
        }
        var bruto = Math.Round(QuantidadeIngrediente * FatorCorrecao, 2);
        FichaFormulario.Ingredientes.Add(CriarIngredienteVm(alimento, QuantidadeIngrediente, bruto, FatorCorrecao, UnidadeIngrediente));
        AlimentoSelecionadoId = 0; QuantidadeIngrediente = 100m; FatorCorrecao = 1m; ErroFicha = "";
