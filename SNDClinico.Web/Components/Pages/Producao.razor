    private void AtualizarFatorCorrecaoSelecionado()
    {
        var alimento = Alimentos.FirstOrDefault(a => a.Id == AlimentoSelecionadoId);
        if (alimento is null) return;
        FatorCorrecao = alimento.FatorCorrecao > 0 ? alimento.FatorCorrecao : 1m;
        AtualizarBrutoPeloLiquido();
    }

    private void AtualizarBrutoPeloLiquido()
    {
        var fc = FatorCorrecao > 0 ? FatorCorrecao : 1m;
        if (QuantidadeIngrediente > 0) QuantidadeBrutaNova = Math.Round(QuantidadeIngrediente * fc, 2);
    }

    private void AtualizarLiquidoPeloBruto()
    {
        var fc = FatorCorrecao > 0 ? FatorCorrecao : 1m;
        if (QuantidadeBrutaNova > 0) QuantidadeIngrediente = Math.Round(QuantidadeBrutaNova / fc, 2);
    }

    private IngredienteFichaVm CriarIngredienteVm(Alimento alimento, decimal quantidadeLiquida, decimal quantidadeBruta, decimal fc, string unidade)
    {
        var unidadeNutricional = alimento.Unidade is "l" or "ml" ? "ml" : alimento.Unidade == "un" ? "un" : "g";
        return new IngredienteFichaVm
        {
            AlimentoId = alimento.Id,
            NomeAlimento = alimento.Nome,
            Unidade = unidade,
            QuantidadeLiquida = quantidadeLiquida,
            QuantidadeBruta = quantidadeBruta,
            FC = fc > 0 ? fc : 1m,
            PrecoSnapshot = alimento.Preco,
            UnidadePreco = alimento.Unidade,
            Calorias = alimento.Calorias,
            Carboidratos = alimento.Carboidratos,
            Proteinas = alimento.Proteinas,
            Lipidios = alimento.Lipidios,
            Fibras = alimento.Fibras,
            Sodio = alimento.Sodio,
            UnidadeNutricional = unidadeNutricional
        };
    }

