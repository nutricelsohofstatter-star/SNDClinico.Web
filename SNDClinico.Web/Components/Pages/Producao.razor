    private async Task SalvarAlimento()
    {
        if (string.IsNullOrWhiteSpace(Formulario.Nome))
        {
            ErroFormulario = "Informe o nome do alimento.";
            return;
        }

        if (UnidadeAlimentoBloqueada)
        {
            var alimentoAtual = Alimentos.FirstOrDefault(a => a.Id == Formulario.Id);
            if (alimentoAtual is not null && alimentoAtual.Unidade != Formulario.Unidade)
            {
                ErroFormulario = "A unidade não pode ser alterada porque existem lotes vinculados a este alimento no Estoque Interno.";
                return;
            }
        }

        if (Formulario.Preco < 0 ||
            Formulario.Calorias < 0 ||
            Formulario.Carboidratos < 0 ||
            Formulario.Proteinas < 0 ||
            Formulario.Lipidios < 0 ||
            Formulario.Fibras < 0 ||
            Formulario.Sodio < 0 ||
            Formulario.FatorCorrecao <= 0)
        {
            ErroFormulario = "Informe valores válidos e um fator de correção maior que zero.";
            return;
        }

        try
        {
            if (Editando)
            {
                var existente = await Db.Alimentos
                    .FirstOrDefaultAsync(a => a.Id == Formulario.Id);

                if (existente is null)
                {
                    ErroFormulario = "O alimento não foi encontrado no banco de dados. Atualize a tela e tente novamente.";
                    await CarregarAlimentosAsync();
                    return;
                }

                existente.Nome = Formulario.Nome.Trim();
                existente.Unidade = Formulario.Unidade;
                existente.Categoria = Formulario.Categoria;
                existente.Ativo = Formulario.Ativo;
                existente.Preco = Formulario.Preco;
                existente.Calorias = Formulario.Calorias;
                existente.Carboidratos = Formulario.Carboidratos;
                existente.Proteinas = Formulario.Proteinas;
                existente.Lipidios = Formulario.Lipidios;
                existente.Fibras = Formulario.Fibras;
                existente.Sodio = Formulario.Sodio;
                existente.FatorCorrecao = Formulario.FatorCorrecao;

                await Db.SaveChangesAsync();

                var indice = Alimentos.FindIndex(a => a.Id == existente.Id);
                if (indice >= 0)
                    Alimentos[indice] = existente;
            }
            else
            {
                var novoAlimento = new Alimento
                {
                    Nome = Formulario.Nome.Trim(),
                    Unidade = Formulario.Unidade,
                    Categoria = Formulario.Categoria,
                    Ativo = Formulario.Ativo,
                    Preco = Formulario.Preco,
                    Calorias = Formulario.Calorias,
                    Carboidratos = Formulario.Carboidratos,
                    Proteinas = Formulario.Proteinas,
                    Lipidios = Formulario.Lipidios,
                    Fibras = Formulario.Fibras,
                    Sodio = Formulario.Sodio,
                    FatorCorrecao = Formulario.FatorCorrecao
                };

                Db.Alimentos.Add(novoAlimento);
                await Db.SaveChangesAsync();
                Alimentos.Add(novoAlimento);
            }

            Alimentos = Alimentos.OrderBy(a => a.Nome).ToList();
            ModalAberto = false;
            ErroFormulario = "";
        }
        catch (DbUpdateException)
        {
            ErroFormulario = "Não foi possível salvar o alimento no banco de dados. Verifique se já existe uma restrição ou dado inválido e tente novamente.";
        }
        catch (Exception)
        {
            ErroFormulario = "Ocorreu um erro ao acessar o banco de dados. Tente novamente.";
        }
    }

    private void SolicitarExclusao(Alimento alimento) =>
        AlimentoParaExcluir = alimento;

    private void CancelarExclusao() =>
        AlimentoParaExcluir = null;

    private async Task ConfirmarExclusao()
    {
        if (AlimentoParaExcluir is null)
            return;

        if (Lotes.Any(l => l.ProdutoId == AlimentoParaExcluir.Id) ||
            Movimentacoes.Any(m => m.ProdutoId == AlimentoParaExcluir.Id))
        {
            ErroFormulario = "Este alimento já possui histórico no Estoque Interno. Altere a situação para Inativo em vez de excluí-lo.";
            AlimentoParaExcluir = null;
            return;
        }

        try
        {
            var alimentoBanco = await Db.Alimentos
                .FirstOrDefaultAsync(a => a.Id == AlimentoParaExcluir.Id);

            if (alimentoBanco is not null)
            {
                Db.Alimentos.Remove(alimentoBanco);
                await Db.SaveChangesAsync();
            }

            Alimentos.RemoveAll(a => a.Id == AlimentoParaExcluir.Id);
            AlimentoParaExcluir = null;
            ErroFormulario = "";
        }
        catch (DbUpdateException)
        {
            ErroFormulario = "Não foi possível excluir este alimento porque existem registros vinculados a ele. Altere a situação para Inativo.";
            AlimentoParaExcluir = null;
        }
        catch (Exception)
        {
            ErroFormulario = "Ocorreu um erro ao excluir o alimento do banco de dados.";
            AlimentoParaExcluir = null;
        }
    }


