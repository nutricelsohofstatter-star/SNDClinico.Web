    <strong>SND HOSPITALAR</strong>
    <span>Plataforma integrada de gestão nutricional hospitalar</span>
    <span>Hospital São Sebastião Mártir</span>
</footer>

</main>
</div>

<div class="prod-modal-host">
    @if (ModalCardapioAberto)
    {
        <div class="menu-edit-backdrop" @onclick="FecharEdicaoCardapio">
            <section class="menu-edit-modal" @onclick:stopPropagation="true">
                <header class="menu-edit-header">
                    <div class="menu-edit-brand">
                        <span class="menu-edit-brand-mark">SND</span>
                        <div><strong>Produção</strong><span>·</span><small>Planejamento de cardápios</small></div>
                    </div>
                    <button type="button" class="menu-edit-close" aria-label="Fechar edição" @onclick="FecharEdicaoCardapio">×</button>
                </header>
                <div class="menu-edit-body">
                    <section class="menu-edit-hero">
                        <img src="images/icons/ico_cardapios.png" alt="" />
                        <div>
                            <span class="menu-edit-hero-kicker">EDIÇÃO DE CARDÁPIO</span>
                            <h2>@RefeicaoEmEdicao – @ModalidadeEmEdicao</h2>
                            <p>@DiaEmEdicao.ToString("dddd, dd 'de' MMMM", Cultura) · Ajuste as preparações, ingredientes e custo da refeição.</p>
                        </div>
                    </section>
                    <div class="menu-edit-context"><span>@EscopoEmEdicao</span><span>@ModalidadeEmEdicao</span></div>
                    @if (EscopoEmEdicao != "Geral")
                    {
                        <label class="menu-inherit-choice"><input type="checkbox" @bind="UsarBaseGeral" /> Herdar preparações do cardápio geral (desmarque para personalizar)</label>
                    }
                    <div class="menu-prep-list">
                        @if (PreparacoesEdicao.Count == 0)
                        {
                            <div class="recipe-empty-state"><strong>Seu cardápio ainda está vazio</strong><span>Escolha uma preparação cadastrada para começar a montar esta modalidade.</span></div>
                        }
                        @foreach (var prep in PreparacoesEdicao)
                        {
                            <div class="menu-prep-edit-row">
                                <div class="menu-prep-main">
                                    <strong>@prep.Nome</strong>
                                    <small>@Numero(prep.PesoPorPorcao) g por porção · custo unitário: @CustoUnitarioPreparacao(prep).ToString("C2", Cultura)</small>
                                    @if (ObterFicha(prep) is FichaTecnicaVm fichaDaPreparacao)
                                    {
                                        <div class="menu-donation-panel">
                                            <div class="menu-donation-heading">
                                                <span class="menu-donation-icon">♡</span>
                                                <div><strong>Ingredientes doados</strong><small>Marque somente os ingredientes recebidos por doação nesta preparação.</small></div>
                                            </div>
                                            <div class="menu-donation-grid">
                                                @foreach (var ingredienteDoado in fichaDaPreparacao.Ingredientes)
                                                {
                                                    <label class="menu-donation-option">
                                                        <input type="checkbox" checked="@prep.IngredientesDoados.Contains(ingredienteDoado.AlimentoId)" @onchange="(ChangeEventArgs e) => AlternarDoacaoIngrediente(prep, ingredienteDoado.AlimentoId, e)" />
                                                        <span>@ingredienteDoado.NomeAlimento</span>
                                                        @if (prep.IngredientesDoados.Contains(ingredienteDoado.AlimentoId))
                                                        {
                                                            <em>Doação</em>
                                                        }
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <button class="menu-remove-prep" title="Remover preparação" aria-label="Remover preparação" @onclick="() => RemoverPreparacao(prep)">×</button>
                            </div>
                        }
                    </div>
                    <section class="menu-cost-summary">
                        <div><span>Custo unitário da refeição</span><strong>@CustoUnitarioRefeicao().ToString("C2", Cultura)</strong></div>
                        <small>Soma do custo por porção de cada preparação vinculada às Fichas Técnicas.</small>
                    </section>
                    <div class="menu-add-prep">
                        <InputSelect @bind-Value="FichaParaAdicionarId">
                            <option value="0">Selecionar preparação das fichas técnicas...</option>@foreach (var ficha in Fichas.Where(x => x.Ativa).OrderBy(x => x.Nome)) {
                            <option value="@ficha.Id">@ficha.Nome</option>
                        }
                    </InputSelect><button @onclick="AdicionarPreparacao">＋ Adicionar</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(ErroCardapio))
            {
                <div class="food-form-error" role="alert">@ErroCardapio</div>
            }
            <footer class="menu-edit-footer"><button class="menu-cancel" @onclick="FecharEdicaoCardapio">Cancelar</button><button class="menu-save" @onclick="SalvarEdicaoCardapio">Salvar alterações</button></footer>
        </section>
    </div>
}
@if (FichaModalAberto)
{
    <div class="recipe-create-backdrop" @onclick="FecharFichaModal">
        <section class="recipe-create-modal" @onclick:stopPropagation="true">
            <header class="recipe-create-topbar">
                <div class="recipe-create-brand">
                    <span class="recipe-create-brand-mark">SND</span>
                    <span>Produção <b>·</b> Fichas técnicas</span>
                </div>
                <button type="button" class="food-modal-close" @onclick="FecharFichaModal" aria-label="Fechar">×</button>
            </header>
            <div class="recipe-create-intro">
                <img src="images/icons/ico_fichas_tecnicas.png" class="recipe-create-3d-icon" alt="" />
                <div>
                    <span class="recipe-create-kicker">FICHAS TÉCNICAS</span>
                    <h2>Nova ficha técnica</h2>
                    <p>Informe os dados iniciais da preparação.</p>
                </div>
            </div>
            <EditForm Model="FichaFormulario" OnValidSubmit="CriarFichaEEditar">
                <div class="recipe-create-body">
                    <div class="food-form-field"><label>Nome da preparação</label><InputText class="food-input" @bind-Value="FichaFormulario.Nome" placeholder="Digite o nome da preparação" /></div>
                    <div class="food-form-field">
                        <label>Categoria</label><InputSelect class="food-input food-select" @bind-Value="FichaFormulario.Categoria">
                        <option value="">Selecione uma categoria</option>@foreach (var categoria in CategoriasPreparacao) {
                        <option value="@categoria">@categoria</option>
                    }
                </InputSelect>
            </div>
            <div class="recipe-create-grid">
                <div class="food-form-field"><label>Quantidade de porções</label><InputNumber class="food-input" @bind-Value="FichaFormulario.Porcoes" min="1" /></div>
                <div class="food-form-field"><label>Peso de cada porção (g)</label><InputNumber class="food-input" @bind-Value="PorcaoInicialGramas" min="1" /></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(ErroFicha))
            {
                <div class="food-form-error">@ErroFicha</div>
            }
        </div>
        <footer><button type="button" class="food-cancel-button" @onclick="FecharFichaModal">Cancelar</button><button type="submit" class="food-save-button">Criar e adicionar ingredientes</button></footer>
    </EditForm>
</section>
</div>
}
@if (ModalAberto)
{
    <div class="food-modal-backdrop" @onclick="FecharModal">
        <section class="food-modal" @onclick:stopPropagation="true">

            <header class="food-modal-header">
                <div class="food-modal-brand">
                    <span class="food-modal-brand-mark">SND</span>
                    <span>Produção <b>·</b> Cadastro de alimentos</span>
                </div>
                <button type="button" class="food-modal-close"
                        @onclick="FecharModal"
                        aria-label="Fechar">
                    ×
                </button>
            </header>

            <div class="food-modal-intro">
                <img src="images/icons/ico_estoque_produtos.png"
                     class="food-modal-3d-icon"
                     alt="" />
                <div class="food-modal-heading">
                    <span class="food-modal-kicker">CADASTRO DE ALIMENTOS</span>
                    <h2>@(Editando ? "Editar alimento" : "Novo alimento")</h2>
                    <p>Informe os dados do alimento e sua composição nutricional.</p>
                </div>
            </div>

            <EditForm Model="Formulario" OnValidSubmit="SalvarAlimento">
                <div class="food-modal-body">

                    <div class="food-form-section">
                        <div class="food-form-section-heading">
                            <img class="food-form-section-icon"
                                 src="images/icons/ico_informacoes_alimento.png"
                                 alt="" />
                            <div>
                                <strong>Informações do alimento</strong>
                                <small>Identificação, unidade e valor de aquisição</small>
                            </div>
                        </div>

                        <div class="food-form-field full">
                            <label for="food-name">Nome do alimento <span>*</span></label>
                            <InputText id="food-name"
                                       class="food-input"
                                       @bind-Value="Formulario.Nome"
                                       placeholder="Ex.: Arroz branco (cru)" />
                        </div>

                        <div class="food-form-grid three food-identification-grid">
                            <div class="food-form-field">
                                <label for="food-unit">Unidade de medida</label>
                                <InputSelect id="food-unit"
                                             class="food-input food-select"
                                             @bind-Value="Formulario.Unidade"
                                             disabled="@UnidadeAlimentoBloqueada">
                                    @foreach (var unidade in UnidadesMedida)
                                    {
                                        <option value="@unidade">@NomeUnidade(unidade)</option>
                                    }
                                </InputSelect>
                                @if (UnidadeAlimentoBloqueada)
                                {
                                    <small class="food-field-hint">A unidade não pode ser alterada porque já existem lotes vinculados a este alimento no Estoque Interno.</small>
                                }
                            </div>

                            <div class="food-form-field">
                                <label for="food-price">Preço (R$/@UnidadePreco(Formulario.Unidade))</label>
                                <InputNumber id="food-price"
                                             class="food-input"
                                             @bind-Value="Formulario.Preco"
                                             min="0"
                                             step="0.01" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-correction-factor">Fator de correção (FC)</label>
                                <InputNumber id="food-correction-factor"
                                             class="food-input"
                                             @bind-Value="Formulario.FatorCorrecao"
                                             min="0.01"
                                             step="0.01" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-category">Categoria</label>
                                <InputSelect id="food-category"
                                             class="food-input food-select"
                                             @bind-Value="Formulario.Categoria">
                                    @foreach (var categoria in CategoriasAlimento)
                                    {
                                        <option value="@categoria">@categoria</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="food-form-field">
                                <label for="food-status">Situação</label>
                                <InputSelect id="food-status"
                                             class="food-input food-select"
                                             @bind-Value="Formulario.Ativo">
                                    <option value="true">Ativo</option>
                                    <option value="false">Inativo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div class="food-modal-divider"></div>

                    <div class="food-form-section">
                        <div class="food-form-section-heading">
                            <img class="food-form-section-icon nutrition-section-icon"
                                 src="images/icons/ico_composicao_nutricional.png"
                                 alt="" />
                            <div>
                                <strong>Composição nutricional da preparação</strong>
                                <small>Valores referentes a 100 g ou 100 ml</small>
                            </div>
                        </div>

                        <div class="food-form-grid three">
                            <div class="food-form-field">
                                <label for="food-calories">Calorias <small>(kcal)</small></label>
                                <InputNumber id="food-calories" class="food-input"
                                             @bind-Value="Formulario.Calorias" min="0" step="0.1" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-carbs">Carboidratos <small>(g)</small></label>
                                <InputNumber id="food-carbs" class="food-input"
                                             @bind-Value="Formulario.Carboidratos" min="0" step="0.1" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-protein">Proteínas <small>(g)</small></label>
                                <InputNumber id="food-protein" class="food-input"
                                             @bind-Value="Formulario.Proteinas" min="0" step="0.1" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-fat">Lipídios <small>(g)</small></label>
                                <InputNumber id="food-fat" class="food-input"
                                             @bind-Value="Formulario.Lipidios" min="0" step="0.1" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-fiber">Fibras <small>(g)</small></label>
                                <InputNumber id="food-fiber" class="food-input"
                                             @bind-Value="Formulario.Fibras" min="0" step="0.1" />
                            </div>

                            <div class="food-form-field">
                                <label for="food-sodium">Sódio <small>(mg)</small></label>
                                <InputNumber id="food-sodium" class="food-input"
                                             @bind-Value="Formulario.Sodio" min="0" step="0.1" />
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ErroFormulario))
                    {
                        <div class="food-form-error">@ErroFormulario</div>
                    }

                </div>

                <footer class="food-modal-footer">
                    <span class="food-required-note">* Campos obrigatórios</span>

                    <div>
                        <button type="button" class="food-cancel-button" @onclick="FecharModal">
                            Cancelar
                        </button>

                        <button type="submit" class="food-save-button">
                            <svg viewBox="0 0 24 24">
                                <path d="m5 12 4 4L19 6" />
                            </svg>
                            @(Editando ? "Salvar alterações" : "Salvar alimento")
                        </button>
                    </div>
                </footer>
            </EditForm>

        </section>
    </div>
}

@if (AlimentoParaExcluir is not null)
{
    <div class="food-modal-backdrop" @onclick="CancelarExclusao">
        <section class="food-confirm-modal" @onclick:stopPropagation="true">
            <div class="food-confirm-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M4 7h16M10 11v6M14 11v6M5 7l1 14h12l1-14M9 7V4h6v3" />
                </svg>
            </div>
            <h3>Excluir alimento?</h3>
            <p>
                Deseja realmente excluir <strong>@AlimentoParaExcluir.Nome</strong> do cadastro?
            </p>
            <div class="food-confirm-actions">
                <button class="food-cancel-button" @onclick="CancelarExclusao">Cancelar</button>
                <button class="food-delete-confirm" @onclick="ConfirmarExclusao">Excluir alimento</button>
            </div>
        </section>
    </div>
}
</div>


