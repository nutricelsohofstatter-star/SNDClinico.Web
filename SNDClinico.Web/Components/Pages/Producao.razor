    private async Task CarregarRelatorioCustosAsync()
    {
        CarregandoRelatorio = true;
        ErroRelatorio = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            var inicio = DateOnly.FromDateTime(DataInicialFiltroRelatorio.Date);
            var fim = DateOnly.FromDateTime(DataFinalFiltroRelatorio.Date);
            var cardapios = await Db.Cardapios.AsNoTracking()
                .Include(c => c.ModalidadeCardapio)
                .Include(c => c.Refeicoes)
                    .ThenInclude(r => r.Preparacoes)
                        .ThenInclude(p => p.IngredientesDoados)
                .Where(c => c.DataInicio <= fim && c.DataFim >= inicio)
                .ToListAsync();

            bool ehEscolinha(SNDClinico.Web.Data.Cardapio c) => c.Escopo.StartsWith("Escolinha|", StringComparison.OrdinalIgnoreCase);
            var cardapiosAmbiente = cardapios
                .Where(c => AmbienteFiltroRelatorio == "Escolinha" ? ehEscolinha(c) : !ehEscolinha(c))
                .ToList();

            string nomeLocal(SNDClinico.Web.Data.Cardapio c) => AmbienteFiltroRelatorio == "Escolinha"
                ? c.Escopo.Substring("Escolinha|".Length)
                : (string.IsNullOrWhiteSpace(c.Escopo) ? "Geral" : c.Escopo);

            EscoposRelatorioDisponiveis = cardapiosAmbiente
                .Select(nomeLocal)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            var linhas = new List<RelatorioCustoLinha>();
            foreach (var cardapio in cardapiosAmbiente)
            {
                var local = nomeLocal(cardapio);
                if (EscopoFiltroRelatorio != "Todos" && !string.Equals(local, EscopoFiltroRelatorio, StringComparison.OrdinalIgnoreCase))
                    continue;

                var modalidade = cardapio.ModalidadeCardapio?.Nome ?? "Não informada";
                if (AmbienteFiltroRelatorio == "Hospital" && ModalidadeFiltroRelatorio != "Todas" && !string.Equals(modalidade, ModalidadeFiltroRelatorio, StringComparison.OrdinalIgnoreCase))
                    continue;

                foreach (var refeicao in cardapio.Refeicoes.Where(r => r.Data >= inicio && r.Data <= fim))
                {
                    if (RefeicaoFiltroRelatorio != "Todas" && !string.Equals(refeicao.Nome, RefeicaoFiltroRelatorio, StringComparison.OrdinalIgnoreCase))
                        continue;

                    decimal custoUnitario = 0m;
                    var nomesPreparacoes = new List<string>();
                    foreach (var preparacao in refeicao.Preparacoes)
                    {
                        var nomePreparacao = preparacao.NomeSnapshot;
                        if (PreparacaoFiltroRelatorio != "Todas" && !string.Equals(nomePreparacao, PreparacaoFiltroRelatorio, StringComparison.OrdinalIgnoreCase))
                            continue;

                        nomesPreparacoes.Add(nomePreparacao);
                        var ficha = Fichas.FirstOrDefault(f => f.Id == preparacao.FichaTecnicaId);
                        if (ficha is null || ficha.Porcoes <= 0) continue;
                        var ingredientesDoados = preparacao.IngredientesDoados.Select(i => i.AlimentoId).ToHashSet();
                        custoUnitario += ficha.Ingredientes
                            .Where(i => !ingredientesDoados.Contains(i.AlimentoId))
                            .Sum(CustoIngredienteReferencia) / ficha.Porcoes;
                    }

                    if (PreparacaoFiltroRelatorio != "Todas" && nomesPreparacoes.Count == 0) continue;
                    var quantidade = Math.Max(0, refeicao.QuantidadePrevista);
                    linhas.Add(new RelatorioCustoLinha
                    {
                        Dia = refeicao.Data.ToDateTime(TimeOnly.MinValue),
                        Ambiente = AmbienteFiltroRelatorio,
                        Local = local,
                        Refeicao = refeicao.Nome,
                        Modalidade = modalidade,
                        QuantidadePlanejada = quantidade,
                        CustoUnitario = custoUnitario,
                        CustoTotal = custoUnitario * quantidade,
                        Preparacoes = nomesPreparacoes
                    });
                }
            }

            LinhasRelatorioCusto = linhas
                .OrderBy(x => x.Dia)
                .ThenBy(x => x.Refeicao, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.Local, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.Modalidade, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        catch (Exception)
        {
            LinhasRelatorioCusto.Clear();
            ErroRelatorio = "Não foi possível carregar os custos do planejamento. Verifique a conexão com o banco de dados e tente novamente.";
        }
        finally
        {
            CarregandoRelatorio = false;
        }
    }

