    private FichaTecnicaVm CriarFichaExemplo(int id, string nome, string categoria, int porcoes, decimal porcaoGramas, string preparo, params (int alimentoId, decimal bruto, decimal liquido, decimal fc)[] itens)
    {
        var ficha = new FichaTecnicaVm
        {
            Id = id,
            Nome = nome,
            Categoria = categoria,
            Porcoes = porcoes,
            RendimentoFinalGramas = porcoes * porcaoGramas,
            Observacoes = preparo,
            Ativa = true
        };

        foreach (var item in itens)
        {
            var alimento = Alimentos.First(a => a.Id == item.alimentoId);
            var unidadeNutricional = alimento.Unidade is "l" or "ml" ? "ml" : alimento.Unidade == "un" ? "un" : "g";
            ficha.Ingredientes.Add(new IngredienteFichaVm
            {
                AlimentoId = alimento.Id,
                NomeAlimento = alimento.Nome,
                Unidade = unidadeNutricional,
                QuantidadeBruta = item.bruto,
                QuantidadeLiquida = item.liquido,
                FC = item.fc,
                PrecoSnapshot = alimento.Preco,
                UnidadePreco = alimento.Unidade,
                Calorias = alimento.Calorias,
                Carboidratos = alimento.Carboidratos,
                Proteinas = alimento.Proteinas,
                Lipidios = alimento.Lipidios,
                Fibras = alimento.Fibras,
                Sodio = alimento.Sodio,
                UnidadeNutricional = unidadeNutricional
            });
        }
        return ficha;
    }

