    private void SalvarPerda()
    {
        var produto = Produtos.FirstOrDefault(p => p.Id == FormPerda.ProdutoId && p.Ativo);
        if (produto is null) { Erro = "Selecione um alimento ativo do Cadastro de Alimentos."; return; }
        if (string.IsNullOrWhiteSpace(FormPerda.CodigoLote)) { Erro = "Informe o código do lote."; return; }

        var lote = Lotes.FirstOrDefault(x =>
            x.ProdutoId == produto.Id &&
            string.Equals(x.Codigo.Trim(), FormPerda.CodigoLote.Trim(), StringComparison.OrdinalIgnoreCase) &&
            x.Quantidade > 0);
        if (lote is null) { Erro = "Não foi encontrado saldo disponível para esse produto e código de lote. Confira o lote ou registre o recebimento primeiro."; return; }
        if (FormPerda.Quantidade <= 0 || FormPerda.Quantidade > lote.Quantidade) { Erro = $"A quantidade deve ser maior que zero e não pode superar o saldo do lote ({lote.Quantidade.ToString("N2", Pt)} {lote.Unidade})."; return; }
        if (string.IsNullOrWhiteSpace(FormPerda.Responsavel) || (FormPerda.Motivo == "Outros" && string.IsNullOrWhiteSpace(FormPerda.Observacao))) { Erro = "Informe o responsável e, quando necessário, descreva o motivo."; return; }

        var custo = FormPerda.Quantidade * lote.CustoUnitario;
        lote.Quantidade -= FormPerda.Quantidade;
        Perdas.Add(new() { Data = DateTime.Now, Produto = produto.Nome, Lote = lote.Codigo, Quantidade = FormPerda.Quantidade, Unidade = lote.Unidade, Motivo = FormPerda.Motivo, Responsavel = FormPerda.Responsavel, Custo = custo });
        Movimentacoes.Add(new() { Data = DateTime.Now, ProdutoId = produto.Id, Tipo = "Perda / descarte", Produto = produto.Nome, Lote = lote.Codigo, Quantidade = FormPerda.Quantidade, Unidade = lote.Unidade, Sinal = "−", Responsavel = FormPerda.Responsavel, Observacao = FormPerda.Motivo + " " + FormPerda.Observacao });
        FecharModalPerda();
    }
