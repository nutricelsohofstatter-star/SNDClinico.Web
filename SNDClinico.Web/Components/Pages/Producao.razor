    protected override async Task OnInitializedAsync()
    {
        await CarregarAlimentosAsync();

        // Remove somente os alimentos demonstrativos antigos que ainda não estejam
        // vinculados a ingredientes de fichas técnicas. Alimentos utilizados são preservados.
        var nomesAlimentosDemonstracao = new[]
        {
            "Abobrinha (crua)",
            "Açúcar refinado",
            "Alho (cru)",
            "Arroz branco (cru)",
            "Banana prata",
            "Batata inglesa (crua)",
            "Café em pó (torrado)",
            "Carne bovina (patinho)",
            "Cenoura (crua)",
            "Frango (peito sem pele)"
        };

        var alimentosDemonstracao = await Db.Alimentos
            .Where(a => nomesAlimentosDemonstracao.Contains(a.Nome))
            .ToListAsync();

        foreach (var alimentoDemo in alimentosDemonstracao)
        {
            var alimentoEmUso = await Db.IngredientesFicha
                .AnyAsync(i => i.AlimentoId == alimentoDemo.Id);

            if (!alimentoEmUso)
                Db.Alimentos.Remove(alimentoDemo);
        }

        if (Db.ChangeTracker.HasChanges())
            await Db.SaveChangesAsync();

        await CarregarAlimentosAsync();

        await CarregarFichasAsync();
        await GarantirModalidadesCardapioAsync();
        await CarregarCardapiosSemanaAsync();
    }

