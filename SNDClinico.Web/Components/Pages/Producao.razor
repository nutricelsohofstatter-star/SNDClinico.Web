@page "/producao"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using SNDClinico.Web.Data
@inject IJSRuntime JSRuntime
@inject SndDbContext Db

<PageTitle>SND Hospitalar | @TituloPagina</PageTitle>

<style>

    .menu-planner-page {
        max-width: 1600px;
        margin: 0 auto;
        padding: 8px 2px 30px;
        color: #203b57
    }

    .menu-planner-heading h1 {
        font-size: 34px !important;
        font-weight: 750;
        letter-spacing: -1px !important;
        color: #153b60 !important
    }

    .menu-planner-heading p {
        font-size: 15px !important;
        line-height: 1.55
    }

    .menu-toolbar {
        align-items: center
    }

    .menu-toolbar-left {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap
    }

    .menu-period-control {
        display: flex;
        align-items: center;
        gap: 9px
    }

    .menu-meal-selector {
        display: flex;
        align-items: center;
        gap: 9px;
        padding-left: 16px;
        border-left: 1px solid #e5edf4
    }

        .menu-meal-selector label, .menu-scope-field label {
            font-size: 11px;
            font-weight: 850;
            letter-spacing: .55px;
            color: #6c8298
        }

    .menu-select {
        font-size: 14px !important;
        font-weight: 650;
        min-width: 210px
    }

    .menu-toolbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap
    }

    .menu-quantity-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f2f7fb;
        border: 1px solid #dfebf4;
        border-radius: 10px;
        padding: 7px 10px
    }

        .menu-quantity-summary label {
            font-size: 11px;
            font-weight: 800;
            color: #58738c
        }

        .menu-quantity-summary input {
            width: 86px;
            height: 34px;
            border: 1px solid #d3e1ec;
            border-radius: 7px;
            padding: 0 8px;
            font-size: 14px;
            font-weight: 750;
            color: #1d4e75;
            background: #fff
        }

    .menu-config-button {
        border: 1px solid #dce7ef;
        background: #fff;
        border-radius: 8px;
        padding: 9px 12px;
        color: #35698f;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer
    }

    .menu-grid-head, .menu-meal-row {
        grid-template-columns: 160px repeat(7,minmax(150px,1fr));
        min-width: 1220px
    }

    .menu-grid-head {
        grid-template-columns: 160px repeat(7,minmax(150px,1fr))
    }

    .menu-modality-row {
        display: grid;
        grid-template-columns: 160px repeat(7,minmax(150px,1fr));
        min-width: 1220px;
        border-bottom: 1px solid #e9eef3
    }

    .menu-modality-label {
        padding: 18px 14px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        background: #fbfcfd;
        border-right: 1px solid #e8eef3
    }

        .menu-modality-label strong {
            font-size: 14px;
            color: #294b69
        }

        .menu-modality-label small {
            font-size: 11px;
            color: #91a0ae
        }

    .menu-day-cell {
        padding: 10px
    }

    .menu-modality-produced {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        padding: 0 2px 6px
    }

        .menu-modality-produced label {
            font-size: 10px;
            font-weight: 750;
            color: #71869a
        }

        .menu-modality-produced input {
            width: 66px;
            height: 29px;
            border: 1px solid #d7e3ed;
            border-radius: 7px;
            padding: 3px 6px;
            text-align: center;
            font-size: 13px;
            font-weight: 800;
            color: #24577e;
            background: #f8fbfd;
            outline: none
        }

            .menu-modality-produced input:focus {
                border-color: #3683bd;
                box-shadow: 0 0 0 2px #3683bd20
            }

    .menu-modality-card {
        min-height: 112px;
        padding: 12px 12px 12px 15px;
        border-radius: 10px;
        gap: 7px
    }

    .menu-modality-name {
        font-size: 11px;
        letter-spacing: .5px
    }

    .menu-prep-name {
        font-size: 13px;
        line-height: 1.45;
        font-weight: 600
    }

    .menu-empty-prep {
        font-size: 12px;
        padding: 7px 0
    }

    .menu-more-preps {
        font-size: 11px
    }

    .menu-inherited-tag {
        font-size: 9px;
        padding: 4px 6px
    }

    .menu-day-head {
        padding: 11px 8px
    }

        .menu-day-head strong {
            font-size: 13px
        }

        .menu-day-head span {
            font-size: 12px
        }

    .menu-config-modal {
        width: min(520px,100%);
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 24px 70px #102a4050;
        overflow: hidden
    }

    .menu-config-list {
        display: flex;
        flex-direction: column;
        gap: 8px
    }

    .menu-config-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        border: 1px solid #e4ebf1;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        color: #355775
    }

    .menu-config-add {
        display: flex;
        gap: 8px
    }

        .menu-config-add input {
            flex: 1;
            min-width: 0;
            height: 40px;
            border: 1px solid #dce5ed;
            border-radius: 8px;
            padding: 0 10px;
            font-size: 13px
        }

        .menu-config-add button {
            border: 0;
            border-radius: 8px;
            background: #1769aa;
            color: #fff;
            padding: 0 14px;
            font-weight: 800;
            cursor: pointer
        }

    .menu-planner-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 22px;
        margin-bottom: 22px
    }

        .menu-planner-heading h1 {
            font-size: 29px;
            letter-spacing: -.7px;
            color: #17385b;
            margin: 7px 0
        }

        .menu-planner-heading p {
            font-size: 13px;
            color: #74869a;
            margin: 0
        }

    .menu-planner-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

    .menu-action {
        border: 1px solid transparent;
        border-radius: 9px;
        padding: 10px 13px;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer
    }

        .menu-action.primary {
            background: #1769aa;
            color: white;
            box-shadow: 0 4px 12px #1769aa25
        }

        .menu-action.secondary {
            background: #f1f6fa;
            color: #356487;
            border-color: #dce8f1
        }

    .menu-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 14px 16px;
        background: #fff;
        border: 1px solid #e3ebf2;
        border-radius: 13px;
        margin-bottom: 14px;
        box-shadow: 0 3px 14px #193b5b08
    }

    .menu-week-nav {
        display: flex;
        align-items: center;
        gap: 12px
    }

        .menu-week-nav > button {
            height: 34px;
            min-width: 34px;
            border: 1px solid #dce7ef;
            background: #f8fbfd;
            border-radius: 8px;
            color: #35698f;
            font-size: 20px;
            cursor: pointer
        }

        .menu-week-nav div {
            display: flex;
            flex-direction: column;
            gap: 2px
        }

        .menu-week-nav strong {
            font-size: 14px;
            color: #234565
        }

        .menu-week-nav small {
            font-size: 10px;
            color: #8a9aaa
        }

        .menu-week-nav .menu-today {
            font-size: 11px;
            padding: 0 11px
        }

    .menu-scope-field {
        display: flex;
        align-items: center;
        gap: 10px
    }

        .menu-scope-field label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .4px;
            color: #718399;
            font-weight: 800
        }

    .menu-select {
        height: 38px;
        min-width: 190px;
        padding: 0 10px;
        border: 1px solid #dce6ee;
        border-radius: 8px;
        color: #294b69;
        background: white;
        font-size: 12px
    }

    .menu-scope-note {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px 15px;
        background: #f3f8fc;
        border: 1px solid #dceaf4;
        border-radius: 11px;
        margin-bottom: 14px
    }

    .menu-note-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #dceefa;
        color: #2671a8;
        font-weight: 800;
        flex: 0 0 24px
    }

    .menu-scope-note strong {
        font-size: 12px;
        color: #285579
    }

    .menu-scope-note p {
        font-size: 11px;
        color: #6f8396;
        margin: 3px 0 0
    }

    .menu-inherit-status {
        margin-left: auto;
        white-space: nowrap;
        padding: 6px 9px;
        background: #e7f4ef;
        color: #2b8068;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 800
    }

    .menu-legend {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 0 0 10px 2px;
        flex-wrap: wrap
    }

        .menu-legend span {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 10px;
            font-weight: 800;
            color: #647b90
        }

        .menu-legend i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block
        }

    .legend-sus {
        background: #3683bd
    }

    .legend-particular {
        background: #8871c5
    }

    .legend-dm {
        background: #27977f
    }

    .legend-pastosa {
        background: #d29a42
    }

    .menu-legend small {
        font-size: 10px;
        color: #91a0ae;
        margin-left: auto
    }

    .menu-week-grid {
        border: 1px solid #e1e9f0;
        border-radius: 13px;
        overflow-x: auto;
        background: #fff;
        box-shadow: 0 4px 18px #193b5b08
    }

    .menu-grid-head, .menu-meal-row {
        display: grid;
        grid-template-columns: 145px repeat(7,minmax(145px,1fr));
        min-width: 1160px
    }

    .menu-grid-head {
        background: #f7f9fb;
        border-bottom: 1px solid #e4ebf1
    }

    .menu-meal-head, .menu-day-head {
        padding: 13px 10px;
        text-align: center;
        border-left: 1px solid #e8eef3
    }

    .menu-meal-head {
        font-size: 9px;
        letter-spacing: .6px;
        color: #8292a2;
        font-weight: 850;
        text-align: left;
        padding-left: 15px
    }

    .menu-day-head {
        display: flex;
        flex-direction: column;
        gap: 3px
    }

        .menu-day-head strong {
            font-size: 11px;
            color: #385a78
        }

        .menu-day-head span {
            font-size: 10px;
            color: #8b9aaa
        }

        .menu-day-head.is-today {
            background: #edf6fd
        }

    .menu-meal-row {
        border-bottom: 1px solid #e9eef3
    }

        .menu-meal-row:last-child {
            border-bottom: 0
        }

    .menu-meal-label {
        padding: 15px 12px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        background: #fbfcfd;
        border-right: 1px solid #e8eef3
    }

        .menu-meal-label strong {
            font-size: 11px;
            color: #294b69
        }

        .menu-meal-label small {
            font-size: 9px;
            color: #91a0ae
        }

    .menu-day-cell {
        padding: 7px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        border-left: 1px solid #edf1f5;
        min-width: 0
    }

    .menu-modality-card {
        position: relative;
        width: 100%;
        min-height: 53px;
        text-align: left;
        border: 1px solid #e4ebf1;
        border-radius: 7px;
        background: #fff;
        padding: 6px 7px 6px 9px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        cursor: pointer;
        transition: .15s
    }

        .menu-modality-card:hover {
            border-color: #8db8d9;
            background: #f8fbfe;
            transform: translateY(-1px)
        }

        .menu-modality-card:before {
            content: "";
            position: absolute;
            left: 0;
            top: 7px;
            bottom: 7px;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: #3683bd
        }

        .menu-modality-card.particular:before {
            background: #8871c5
        }

        .menu-modality-card.dm:before {
            background: #27977f
        }

        .menu-modality-card.pastosa:before {
            background: #d29a42
        }

    .menu-modality-name {
        font-size: 8px;
        letter-spacing: .35px;
        font-weight: 850;
        color: #6c8296
    }

    .menu-prep-name {
        font-size: 9px;
        line-height: 1.3;
        color: #294761;
        overflow-wrap: anywhere
    }

    .menu-empty-prep {
        font-size: 9px;
        color: #9aa9b6;
        padding: 3px 0
    }

    .menu-more-preps {
        font-size: 8px;
        color: #6488a5
    }

    .menu-inherited-tag {
        align-self: flex-start;
        font-size: 7px;
        color: #43816f;
        background: #eaf5f1;
        border-radius: 4px;
        padding: 2px 4px
    }

    .menu-planner-footnote {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        margin-top: 13px;
        color: #8595a5;
        font-size: 10px;
        line-height: 1.5
    }

    .menu-edit-backdrop {
        position: fixed;
        inset: 0;
        background: #12283d88;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px
    }

    .menu-edit-modal {
        width: min(640px,100%);
        max-height: 84vh;
        overflow: auto;
        background: white;
        border: 1px solid #e3ebf2;
        border-radius: 15px;
        box-shadow: 0 22px 64px #102a4050
    }

    .menu-edit-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 16px 19px;
        border-bottom: 1px solid #e9eef3;
        background: linear-gradient(180deg,#fbfdff,#fff)
    }

        .menu-edit-header h2 {
            font-size: 19px;
            font-weight: 800;
            color: #173e60;
            margin: 0;
            letter-spacing: -.35px
        }

        .menu-edit-header p {
            font-size: 12px;
            color: #71869a;
            margin: 5px 0 0
        }

    .menu-edit-close {
        border: 0;
        background: #f1f5f8;
        border-radius: 8px;
        width: 30px;
        height: 30px;
        font-size: 20px;
        color: #60788d;
        cursor: pointer
    }

    .menu-edit-body {
        padding: 15px 19px;
        display: flex;
        flex-direction: column;
        gap: 11px
    }

    .menu-edit-context {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

        .menu-edit-context span {
            padding: 6px 10px;
            border-radius: 7px;
            background: #edf5fb;
            color: #2c6794;
            font-size: 11px;
            font-weight: 800
        }

    .menu-inherit-choice {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: 11px;
        color: #526e84
    }

    .menu-prep-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 290px;
        overflow: auto;
        padding: 1px
    }

    .menu-prep-edit-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) 36px;
        gap: 10px;
        align-items: center;
        padding: 11px 12px;
        background: #fbfdff;
        border: 1px solid #e2ebf3;
        border-radius: 10px;
        transition: .15s
    }

        .menu-prep-edit-row:hover {
            border-color: #b8d2e5;
            background: #f7fbfe
        }

        .menu-prep-edit-row strong {
            font-size: 13px;
            font-weight: 750;
            color: #244b6b
        }

        .menu-prep-edit-row small {
            display: block;
            font-size: 10px;
            color: #8295a6;
            margin-top: 4px
        }

        .menu-prep-edit-row input {
            height: 34px;
            width: 100%;
            border: 1px solid #dce5ed;
            border-radius: 7px;
            padding: 0 8px;
            font-size: 11px
        }

    .menu-remove-prep {
        height: 32px;
        width: 34px;
        border: 0;
        border-radius: 8px;
        background: #fff1f0;
        color: #bd5a52;
        font-size: 19px;
        cursor: pointer
    }

        .menu-remove-prep:hover {
            background: #ffe3e1
        }

    .menu-add-prep {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 8px
    }

        .menu-add-prep select {
            height: 42px;
            min-width: 0;
            border: 1px solid #d6e2ec;
            border-radius: 9px;
            padding: 0 11px;
            color: #34536e;
            font-size: 12px;
            background: #fff
        }

        .menu-add-prep button {
            border: 0;
            border-radius: 9px;
            background: #e8f2fa;
            color: #226a9e;
            padding: 0 15px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer
        }

            .menu-add-prep button:hover {
                background: #d9eaf7
            }

    .menu-general-quantity {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #f7fafc;
        border: 1px solid #e8eef3;
        border-radius: 9px
    }

        .menu-general-quantity label {
            font-size: 10px;
            color: #6c8296;
            font-weight: 800
        }

        .menu-general-quantity input {
            height: 34px;
            width: 100px;
            border: 1px solid #dce5ed;
            border-radius: 7px;
            padding: 0 8px
        }

    .menu-edit-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 19px;
        border-top: 1px solid #e9eef3;
        background: #fbfcfd
    }

        .menu-edit-footer button {
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer
        }

    .menu-cancel {
        background: #f2f5f7;
        border: 1px solid #e3e9ee;
        color: #60768a
    }

    .menu-save {
        background: #1769aa;
        border: 1px solid #1769aa;
        color: white
    }

    @@media(max-width:900px) {
        .menu-planner-heading {
            align-items: flex-start;
            flex-direction: column
        }

        .menu-toolbar {
            align-items: flex-start;
            flex-direction: column
        }

        .menu-scope-field {
            width: 100%;
            justify-content: space-between
        }

        .menu-select {
            flex: 1
        }

        .menu-planner-actions {
            width: 100%
        }

        .menu-action {
            flex: 1
        }
    }

    @@media(max-width:600px) {
        .menu-planner-heading h1 {
            font-size: 24px
        }

        .menu-planner-actions {
            display: grid;
            grid-template-columns: 1fr 1fr
        }

            .menu-planner-actions .primary {
                grid-column: 1/-1
            }

        .menu-week-nav {
            width: 100%;
            gap: 7px
        }

            .menu-week-nav div {
                flex: 1
            }

        .menu-inherit-status {
            display: none
        }

        .menu-edit-backdrop {
            padding: 8px
        }

        .menu-edit-header, .menu-edit-body, .menu-edit-footer {
            padding-left: 15px;
            padding-right: 15px
        }

        .menu-prep-edit-row {
            grid-template-columns: minmax(0,1fr) 32px
        }
    }

    .menu-print-header {
        display: none;
    }

    .food-empty-illustration {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 82px;
        height: 82px;
        margin: 0 auto 12px;
        border-radius: 22px;
        background: linear-gradient(145deg, #f2f8ff, #e8f3ff);
    }

        .food-empty-illustration svg {
            display: block;
            width: 72px;
            height: 72px;
        }

    .food-empty {
        padding: 42px 18px !important;
        text-align: center;
    }

        .food-empty strong {
            display: block;
            color: #244b70;
            font-size: 13px;
            font-weight: 750;
        }

        .food-empty span {
            display: block;
            margin-top: 6px;
            color: #7890a8;
            font-size: 11px;
        }

    @@media print {
        @@page {
            size: landscape;
            margin: 12mm;
        }

        .menu-print-header {
            display: block !important;
            text-align: center;
            margin: 0 0 16px;
            padding: 0 0 12px;
            border-bottom: 1.5px solid #294d6d;
            color: #17395f;
            page-break-after: avoid;
        }

            .menu-print-header h1 {
                margin: 0 0 4px;
                font-size: 19pt;
                line-height: 1.2;
                font-weight: 800;
            }

            .menu-print-header p {
                margin: 0 0 8px;
                color: #526b85;
                font-size: 10pt;
            }

            .menu-print-header h2 {
                margin: 8px 0 3px;
                font-size: 14pt;
                font-weight: 800;
                text-transform: uppercase;
            }

        .menu-print-period {
            color: #526b85;
            font-size: 8.5pt;
        }

        .prod-sidebar, .prod-footer, .menu-planner-heading, .menu-planner-actions,
        .menu-toolbar, .menu-scope-note, .menu-legend, .menu-planner-footnote,
