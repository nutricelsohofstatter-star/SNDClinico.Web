                            <div class="stock-extrato-balance">
                                <small>Saldo físico atual</small>
                                <b>@SaldoFisico(ProdutoExtratoId).ToString("N2", Pt) @(produtoSelecionado?.UnidadeMedida)</b>
                            </div>
                        </div>
