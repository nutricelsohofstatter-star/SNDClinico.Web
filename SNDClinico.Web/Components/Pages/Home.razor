<path d="M15 35V77M20 35V77M78 62V84M84 62V84" stroke="#174AA7" stroke-width="5" stroke-linecap="round"/>
<path d="M13 75H87" stroke="url(#bedFrame)" stroke-width="6" stroke-linecap="round"/>
<path d="M19 58C19 53 23 49 28 49H77C82 49 86 53 86 58V68H19V58Z" fill="url(#bedMattress)" stroke="#4A9CEB" stroke-width="2"/>
<path d="M24 48C24 43 28 40 33 40H46C50 40 53 43 53 47V57H24V48Z" fill="url(#bedPillow)" stroke="#83C9F5" stroke-width="1.6"/>
<path d="M19 60H87" stroke="#FFF" stroke-width="2" opacity=".9"/><path d="M18 70H87" stroke="#1C62BD" stroke-width="3" stroke-linecap="round"/>
<circle cx="23" cy="85" r="5" fill="#173F91"/><circle cx="23" cy="85" r="2.2" fill="#B9E7FF"/><circle cx="79" cy="85" r="5" fill="#173F91"/><circle cx="79" cy="85" r="2.2" fill="#B9E7FF"/>
<path d="M11 19V75M8 19H15M11 23H28" stroke="#2E73CF" stroke-width="2.5" stroke-linecap="round"/>
<path d="M16 24H28V43H16C14 43 13 41 13 39V28C13 26 14 24 16 24Z" fill="url(#ivBag)" stroke="#4C9AD9" stroke-width="1.5"/>
<path d="M17 29H25" stroke="#FFF" stroke-width="2" stroke-linecap="round"/><path d="M22 43V51" stroke="#4C9AD9" stroke-width="1.8"/>
<rect x="59" y="8" width="31" height="28" rx="5" fill="url(#monitor)" stroke="#A9D8FF" stroke-width="2"/><rect x="63" y="12" width="23" height="19" rx="2.5" fill="#102B4E"/>
<path d="M65 22H69L72 17L76 27L79 20H84" stroke="#39E6D0" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M74 36V42" stroke="#477CB8" stroke-width="3" stroke-linecap="round"/><path d="M31 45C35 42 42 42 46 45" stroke="#FFF" stroke-width="2" stroke-linecap="round" opacity=".9"/>
</svg>
                            </div>
                        </div>
                    </div>
                </a>

                <!-- SND PRODUÇÃO -->
                <a href="/producao" class="snd-module-card production-card">

                    <div class="snd-module-image">
                        <img src="/images/modulo-producao.jpg"
                             alt="Equipe preparando refeições na cozinha hospitalar" />

                        <div class="snd-image-shade"></div>
                        <div class="snd-image-decoration production-decoration"></div>

                        <div class="snd-image-heading">
                            <div class="snd-module-icon production-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="sndClocheTop" x1="12" y1="12" x2="53" y2="48" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF"/><stop offset=".34" stop-color="#D9FFFC"/><stop offset="1" stop-color="#53D7D4"/>
    </linearGradient>
    <linearGradient id="sndClocheBase" x1="10" y1="43" x2="55" y2="57" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF"/><stop offset=".5" stop-color="#B5F4EF"/><stop offset="1" stop-color="#23B9C0"/>
    </linearGradient>
    <linearGradient id="sndClocheKnob" x1="27" y1="5" x2="38" y2="17" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF"/><stop offset="1" stop-color="#72E7DF"/>
    </linearGradient>
  </defs>
  <ellipse cx="32" cy="54" rx="23" ry="4.5" fill="#006F80" fill-opacity=".24"/>
  <path d="M11 43H53L49 51H15L11 43Z" fill="url(#sndClocheBase)" stroke="#E9FFFC" stroke-width="1.5" stroke-linejoin="round"/>
  <path d="M14 41C15.5 25 22.5 17 32 17C41.5 17 48.5 25 50 41H14Z" fill="#007F91" fill-opacity=".28"/>
  <path d="M13 39C14.5 24 22 16 32 16C42 16 49.5 24 51 39H13Z" fill="url(#sndClocheTop)" stroke="#E8FFFC" stroke-width="1.6"/>
  <path d="M20 34C22 25 26 21 32 20" stroke="white" stroke-width="3" stroke-linecap="round" opacity=".9"/>
  <path d="M28 14C28 10.5 29.7 8 32 8C34.3 8 36 10.5 36 14V16H28V14Z" fill="url(#sndClocheKnob)" stroke="#E9FFFC" stroke-width="1.4"/>
  <ellipse cx="32" cy="16" rx="7" ry="2.3" fill="#E9FFFC" fill-opacity=".8"/>
  <path d="M8 42H56" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M17 48H47" stroke="#1A9FA7" stroke-width="1.8" stroke-linecap="round" opacity=".55"/>
</svg>
                            </div>

                            <div class="snd-image-title">
                                <span>GESTÃO DA ALIMENTAÇÃO</span>
                                <h3>SND Produção</h3>
                            </div>

                            <span class="snd-image-arrow">↗</span>
                        </div>
                    </div>

                    <div class="snd-card-details">
                        <p>
                            Alimentação hospitalar: cadastro de alimentos,
                            fichas técnicas, planejamento de cardápios e custos.
                        </p>

                        <div class="snd-card-bottom">
                            <span class="snd-action production-action">
                                Abrir módulo
                                <svg viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </span>

                            <!-- ILUSTRAÇÃO PRODUÇÃO -->
                            <div class="snd-card-decoration production-card-decoration">
                                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Panela 3D com legumes frescos">
<defs>
<linearGradient id="potBody" x1="24" y1="42" x2="78" y2="82"><stop stop-color="#FFF"/><stop offset=".28" stop-color="#C8D7E5"/><stop offset=".62" stop-color="#8298AC"/><stop offset="1" stop-color="#405A70"/></linearGradient>
<linearGradient id="potLid" x1="27" y1="30" x2="74" y2="49"><stop stop-color="#FFF"/><stop offset=".5" stop-color="#DCE8F0"/><stop offset="1" stop-color="#7C91A5"/></linearGradient>
<linearGradient id="potBase" x1="26" y1="74" x2="78" y2="83"><stop stop-color="#2CCBC8"/><stop offset="1" stop-color="#087F9A"/></linearGradient>
<linearGradient id="leaf" x1="10" y1="45" x2="35" y2="69"><stop stop-color="#C7F56B"/><stop offset="1" stop-color="#299C43"/></linearGradient>
<linearGradient id="tomato" x1="24" y1="59" x2="42" y2="81"><stop stop-color="#FF8B64"/><stop offset="1" stop-color="#D92E24"/></linearGradient>
<linearGradient id="carrot" x1="70" y1="68" x2="93" y2="83"><stop stop-color="#FFD36A"/><stop offset="1" stop-color="#F07816"/></linearGradient>
<filter id="potShadow" x="4" y="12" width="94" height="84"><feGaussianBlur stdDeviation="2.2"/></filter>
</defs>
<ellipse cx="53" cy="88" rx="40" ry="5.5" fill="#176A78" opacity=".18" filter="url(#potShadow)"/>
<path d="M29 45H74C78 45 81 49 80 54L75 76C74 81 70 84 65 84H38C33 84 29 81 28 76L23 54C22 49 25 45 29 45Z" fill="url(#potBody)" stroke="#526F85" stroke-width="1.7"/>
<path d="M25 52H78" stroke="#FFF" stroke-width="2.2" opacity=".85"/><path d="M20 51H27M77 51H84" stroke="#617B90" stroke-width="5" stroke-linecap="round"/>
<path d="M31 79H72" stroke="url(#potBase)" stroke-width="6" stroke-linecap="round"/>
<path d="M25 45C29 37 39 33 52 33C65 33 75 37 79 45H25Z" fill="url(#potLid)" stroke="#71899D" stroke-width="1.7"/>
<path d="M34 41C41 36 59 35 69 40" stroke="#FFF" stroke-width="2.5" stroke-linecap="round" opacity=".9"/>
<path d="M45 32C45 28 48 25 52 25C56 25 59 28 59 32" stroke="#536C81" stroke-width="3" stroke-linecap="round"/><rect x="47" y="22" width="10" height="5" rx="2.5" fill="#DCE8F0" stroke="#647E92" stroke-width="1"/>
<path d="M45 18C40 13 44 9 47 7M57 18C62 13 58 9 55 7" stroke="#B8CBD9" stroke-width="2.5" stroke-linecap="round" opacity=".8"/>
<path d="M20 64C12 58 11 49 17 44C24 42 30 48 30 56C28 61 25 64 20 64Z" fill="url(#leaf)" stroke="#348E43" stroke-width="1.2"/>
<path d="M15 53C20 54 24 57 27 61M22 46C22 52 21 56 20 61" stroke="#E9FFB4" stroke-width="1.5" stroke-linecap="round"/>
<path d="M31 62C37 58 44 61 46 68C47 75 41 81 34 80C27 79 25 68 31 62Z" fill="url(#tomato)" stroke="#C62E27" stroke-width="1.2"/>
<path d="M35 62L34 58L38 61L41 58L41 63" stroke="#3D9A45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M66 77L88 69L84 83L70 85Z" fill="url(#carrot)" stroke="#D86D13" stroke-width="1.2" stroke-linejoin="round"/><path d="M87 69L91 65M84 71L85 66" stroke="#49A64C" stroke-width="2.2" stroke-linecap="round"/>
</svg>
                            </div>
                        </div>
                    </div>
                </a>

            </div>
        </section>

        <!-- RODAPÉ -->
        <footer class="snd-footer">
            <div class="snd-footer-left">
                <strong>SND HOSPITALAR</strong>
                <span class="snd-footer-divider"></span>
                <span>Plataforma integrada de gestão nutricional hospitalar</span>
            </div>

            <div class="snd-footer-right">
                <svg viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12h4l3-8 4 16 3-8h6" />
                </svg>
                <span>Hospital São Sebastião Mártir</span>
            </div>
        </footer>

    </div>
</main>



@code {
    private DateTime Agora => DateTime.UtcNow.AddHours(-3);

    private string Saudacao => Agora.Hour switch
    {
        >= 5 and < 12 => "Bom dia!",
        >= 12 and < 18 => "Boa tarde!",
        _ => "Boa noite!"
    };

    private string DataAtual =>
        Agora.ToString(
            "dd 'de' MMMM 'de' yyyy '('dddd')'",
            new System.Globalization.CultureInfo("pt-BR")
        );
}
