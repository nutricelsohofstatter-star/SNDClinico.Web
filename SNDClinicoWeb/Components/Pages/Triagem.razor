@page "/triagem"
@inject HospitalStore Store
<PageTitle>Triagem | SND Clínico</PageTitle>
<div class="app-page">
<header class="hero compact"><div class="hero-icon">▣</div><div><span class="eyebrow">SND CLÍNICO</span><h1>Triagem <em>Nutricional</em></h1><p>Registro e acompanhamento dos pacientes internados</p></div><a href="/" class="btn pale close-action">Voltar</a></header>
<nav class="actions"><a href="/" class="btn pale">Início</a><a href="/mapa-adulto" class="btn sky">Mapa de dieta</a><button class="btn blue" @onclick="()=>modalNovo=true">＋ Novo paciente</button></nav>
<section class="panel"><div class="section-heading"><div class="section-icon">▣</div><div><h2>Pacientes internados</h2><p>Triagem e classificação de demonstração</p></div></div>
@if (Store.Pacientes().Count==0){<div class="empty">Nenhum paciente cadastrado. Clique em <b>Novo paciente</b> para testar.</div>}
else {<div class="table-scroll"><table><thead><tr><th>Paciente</th><th>Idade</th><th>Leito</th><th>Unidade</th><th>Triagem</th><th>Estado nutricional</th><th>Ação</th></tr></thead><tbody>
@foreach(var p in Store.Pacientes()) {<tr><td><strong>@p.Nome</strong></td><td>@p.Idade anos</td><td>@p.Leito</td><td>@p.Unidade</td><td><span class="chip @(p.Triagem=="Realizada"?"ok":"pending")">@p.Triagem</span></td><td>@p.EstadoNutricional</td><td><button class="small-button" @onclick="()=>AbrirTriagem(p)">Avaliar</button></td></tr>}
</tbody></table></div>}
</section>
@if(modalNovo){<div class="overlay" @onclick="()=>modalNovo=false"><section class="modal" @onclick:stopPropagation="true"><div class="modal-banner"><div><span class="eyebrow">SND CLÍNICO</span><h2>Novo paciente</h2><p>Cadastro de demonstração</p></div><button class="x" @onclick="()=>modalNovo=false">×</button></div><div class="modal-body"><label>Nome</label><input @bind="nome" maxlength="160"/><div class="field-grid"><div><label>Idade</label><input type="number" min="0" max="125" @bind="idade"/></div><div><label>Leito</label><input @bind="leito" maxlength="30"/></div></div><label>Unidade</label><select @bind="unidade"><option>Clínica médica</option><option>Clínica cirúrgica</option><option>UTI adulto</option><option>Pediatria</option></select>@if(erro is not null){<p class="error">@erro</p>}</div><footer class="modal-footer"><button class="btn pale" @onclick="()=>modalNovo=false">Cancelar</button><button class="btn blue" @onclick="Salvar">Salvar cadastro</button></footer></section></div>}
@if(avaliado is not null){<div class="overlay" @onclick="()=>avaliado=null"><section class="modal" @onclick:stopPropagation="true"><div class="modal-banner"><div><span class="eyebrow">TRIAGEM NUTRICIONAL</span><h2>@avaliado.Nome</h2><p>@avaliado.Leito · @avaliado.Unidade</p></div><button class="x" @onclick="()=>avaliado=null">×</button></div><div class="modal-body"><p class="note">Esta seleção é demonstrativa. Os métodos clínicos e seus critérios precisam ser configurados e validados antes do uso real.</p><label>Classificação</label><select @bind="classificacao"><option>Sem risco nutricional</option><option>Risco nutricional</option><option>Desnutrição</option><option>Não avaliado</option></select></div><footer class="modal-footer"><button class="btn pale" @onclick="()=>avaliado=null">Cancelar</button><button class="btn blue" @onclick="SalvarTriagem">Registrar triagem</button></footer></section></div>}
</div>
@code {private bool modalNovo; private string nome=""; private int idade=40;private string leito="";private string unidade="Clínica médica";private string? erro;private PacienteInternado? avaliado;private string classificacao="Sem risco nutricional";
private void Salvar(){try{Store.AdicionarPaciente(nome,idade,leito,unidade);modalNovo=false;nome="";leito="";erro=null;}catch(Exception ex){erro=ex.Message;}}
private void AbrirTriagem(PacienteInternado p){avaliado=p;classificacao=p.EstadoNutricional=="Não avaliado"?"Sem risco nutricional":p.EstadoNutricional;}
private void SalvarTriagem(){if(avaliado is null)return;Store.RegistrarTriagem(avaliado.Id,"Realizada",classificacao);avaliado=null;}}
